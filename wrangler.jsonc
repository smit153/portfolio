// The site, deployed as a Cloudflare Worker serving the built pages (Astro's recommended Cloudflare setup).
// Workers Builds: build command `pnpm build`, deploy command `npx wrangler deploy`. GITHUB_TOKEN is a build
// variable there, for scripts/fetch-github.mjs.
{
	"name": "smiit",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": { "binding": "ASSETS", "directory": "./dist" },
	// served only at the domain: no workers.dev address, no per-version preview URLs
	"routes": [
		{ "pattern": "smiit.in", "custom_domain": true },
		{ "pattern": "www.smiit.in", "custom_domain": true }
	],
	"workers_dev": false,
	"preview_urls": false,
	"observability": { "enabled": true }
}
