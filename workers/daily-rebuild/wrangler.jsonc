// The daily rebuild: a tiny Worker whose only job is to hit the site's deploy hook (Workers Builds) on a schedule.
// Deploy from this folder with `npx wrangler deploy`, then `npx wrangler secret put DEPLOY_HOOK_URL`.
{
	"name": "smiit-daily-rebuild",
	"main": "src/index.js",
	"compatibility_date": "2026-10-01",
	// 00:30 UTC is 06:00 in India, so the morning's graph includes yesterday
	"triggers": { "crons": ["30 0 * * *"] },
	// it only runs on its schedule, so no public workers.dev address
	"workers_dev": false,
	"preview_urls": false,
	"observability": { "enabled": true }
}
