---
import { getContributions } from '../lib/github';

const LOGIN = 'smit153';
const CELL = 11;
const GAP = 3;
const STEP = CELL + GAP;
const LABEL_H = 18;
// neutral grays from the page palette: empty → busiest
const SHADES = ['var(--color-line)', '#383838', 'var(--color-tick)', 'var(--color-muted)', '#c4c4c4'];

const calendar = await getContributions(LOGIN);
const days = calendar?.days ?? [];

// columns are weeks starting on Sunday; pad the first week so day 0 lands on its weekday row
const firstWeekday = days.length ? new Date(`${days[0].date}T00:00:00Z`).getUTCDay() : 0;
const cells = days.map((d, i) => ({ ...d, col: Math.floor((i + firstWeekday) / 7), row: (i + firstWeekday) % 7 }));
const cols = cells.length ? cells[cells.length - 1].col + 1 : 53;
const width = cols * STEP - GAP;
const height = LABEL_H + 7 * STEP - GAP;

// month label over the first column that starts a new month (skipped if too close to the previous one)
const monthFmt = new Intl.DateTimeFormat('en-US', { month: 'short', timeZone: 'UTC' });
const months: { col: number; label: string }[] = [];
for (const c of cells) {
	if ((c.row !== 0 && c !== cells[0]) || c.col > cols - 3) continue; // no room for a label in the last weeks
	const m = monthFmt.format(new Date(`${c.date}T00:00:00Z`));
	const prev = months[months.length - 1];
	if (!prev || (prev.label !== m && c.col - prev.col >= 3)) months.push({ col: c.col, label: m });
}

const dateFmt = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
// non-breaking spaces keep each date on one line when the caption wraps
const fmt = (date: string) => dateFmt.format(new Date(`${date}T00:00:00Z`)).replace(/ /g, '\u00a0');
const range = days.length ? `${fmt(days[0].date)} – ${fmt(days[days.length - 1].date)}` : '';
const link = 'underline decoration-tick underline-offset-4 transition-colors hover:decoration-white';
---

<figure class="px-3 py-5">
	<div class="overflow-x-auto [scrollbar-width:none]" data-graph-scroll>
		<svg
			width={width}
			height={height}
			viewBox={`0 0 ${width} ${height}`}
			role="img"
			aria-label={calendar ? `${calendar.total} GitHub contributions, ${range}` : 'GitHub contributions unavailable'}
			class="block font-sohne"
		>
			{
				months.map(({ col, label }) => (
					<text x={col * STEP} y={12} class="fill-muted text-[11px]">
						{label}
					</text>
				))
			}
			{
				cells.map(({ col, row, count, date, level }) => (
					<rect x={col * STEP} y={LABEL_H + row * STEP} width={CELL} height={CELL} fill={SHADES[level]}>
						<title>{`${count} contribution${count === 1 ? '' : 's'} on ${fmt(date)}`}</title>
					</rect>
				))
			}
		</svg>
	</div>

	<figcaption class="mt-3 flex flex-wrap items-center justify-between gap-x-6 gap-y-2 text-[13px] text-white">
		<p>
			<span class="text-muted">Fig. 1.</span>{' '}
			{
				calendar ? (
					<>
						{calendar.total.toLocaleString('en-US')} contributions, {range}. Source:{' '}
						<a href={`https://github.com/${LOGIN}`} target="_blank" rel="noopener noreferrer" class={link}>
							GitHub
						</a>
						.
					</>
				) : (
					<>GitHub contributions are unavailable right now.</>
				)
			}
		</p>
		<p class="flex items-center gap-1 text-muted" aria-hidden="true">
			Less
			{SHADES.map((fill) => <span class="size-[11px]" style={`background:${fill}`} />)}
			More
		</p>
	</figcaption>
</figure>

<script>
	// on narrow screens, start scrolled to the most recent weeks
	document.querySelectorAll<HTMLElement>('[data-graph-scroll]').forEach((el) => (el.scrollLeft = el.scrollWidth));
</script>
