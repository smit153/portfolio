---
import { getContributions } from '../lib/github';

const LOGIN = 'smit153';
const CELL = 11;
const GAP = 3;
const STEP = CELL + GAP;
const LABEL_H = 18;
// empty → busiest: an empty day sits just above the page so any contribution stands out against it,
// then four clear steps of grey up to white
const SHADES = ['#151516', '#4a4a4a', '#7a7a7a', '#b0b0b0', '#ffffff'];

const calendar = getContributions(LOGIN);
const days = calendar?.days ?? [];

// columns are weeks starting on Sunday; pad the first week so day 0 lands on its weekday row
const firstWeekday = days.length ? new Date(`${days[0].date}T00:00:00Z`).getUTCDay() : 0;
const cells = days.map((d, i) => ({ ...d, col: Math.floor((i + firstWeekday) / 7), row: (i + firstWeekday) % 7 }));
const cols = cells.length ? cells[cells.length - 1].col + 1 : 53;
const width = cols * STEP - GAP;
const height = LABEL_H + 7 * STEP - GAP;

// month label over the first column that starts a new month (skipped if too close to the previous one)
const monthFmt = new Intl.DateTimeFormat('en-US', { month: 'short', timeZone: 'UTC' });
const months: { col: number; label: string }[] = [];
for (const c of cells) {
	if ((c.row !== 0 && c !== cells[0]) || c.col > cols - 3) continue; // no room for a label in the last weeks
	const m = monthFmt.format(new Date(`${c.date}T00:00:00Z`));
	const prev = months[months.length - 1];
	if (!prev || (prev.label !== m && c.col - prev.col >= 3)) months.push({ col: c.col, label: m });
}

const dateFmt = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
// non-breaking spaces keep each date on one line when the caption wraps
const fmt = (date: string) => dateFmt.format(new Date(`${date}T00:00:00Z`)).replace(/ /g, '\u00a0');
// the tooltip's date, e.g. "Mon, 6 Oct 2025"
const dayFmt = new Intl.DateTimeFormat('en-GB', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
const day = (date: string) => dayFmt.format(new Date(`${date}T00:00:00Z`));
const range = days.length ? `${fmt(days[0].date)} – ${fmt(days[days.length - 1].date)}` : '';
const link = 'underline decoration-tick underline-offset-4 transition-colors hover:decoration-white';
---

<figure class="relative px-3 py-5" data-graph>
	<!-- when the graph is wider than the column it scrolls, and the edges with more to see fade out instead of cutting off -->
	<div class="graph-scroll overflow-x-auto [scrollbar-width:none]" data-graph-scroll>
		<svg
			width={width}
			height={height}
			viewBox={`0 0 ${width} ${height}`}
			role="img"
			aria-label={calendar ? `${calendar.total} GitHub contributions, ${range}` : 'GitHub contributions unavailable'}
			class="block font-sohne"
		>
			{
				months.map(({ col, label }) => (
					<text x={col * STEP} y={12} class="fill-muted text-tiny">
						{label}
					</text>
				))
			}
			{
				cells.map(({ col, row, count, date, level }) => (
					<rect x={col * STEP} y={LABEL_H + row * STEP} width={CELL} height={CELL} fill={SHADES[level]} data-count={count} data-day={day(date)} />
				))
			}
		</svg>
	</div>

	<!-- the hover tooltip (filled in by the script below) -->
	<div data-graph-tip aria-hidden="true" class="pointer-events-none absolute left-0 top-0 z-10 hidden whitespace-nowrap border border-[#383838] bg-ink px-2 py-1 text-small text-muted"></div>

	<figcaption class="mt-3 flex flex-wrap items-center justify-between gap-x-6 gap-y-2 text-small text-white">
		<!-- desktop: the count and its source on the left, the legend on the right. phones: the count on its own line,
		     then the source on the left of the legend's row -->
		<p class="max-sm:w-full">
			{
				calendar ? (
					<>
						{/* phones get the short version; one line, so no stray space before the comma */}
						{calendar.total.toLocaleString('en-US')} contributions<span class="sm:hidden"> in the last year</span><span class="max-sm:hidden">, {range}</span>.
						<span class="max-sm:hidden">
							{' '}Source:{' '}
							<a href={`https://github.com/${LOGIN}`} target="_blank" rel="noopener noreferrer" class={link}>
								GitHub
							</a>
							.
						</span>
					</>
				) : (
					<>GitHub contributions are unavailable right now.</>
				)
			}
		</p>
		{
			calendar && (
				<p class="sm:hidden">
					Source:{' '}
					<a href={`https://github.com/${LOGIN}`} target="_blank" rel="noopener noreferrer" class={link}>
						GitHub
					</a>
				</p>
			)
		}
		<p class="flex items-center gap-1 text-muted" aria-hidden="true">
			Less
			{SHADES.map((fill) => <span class="size-[11px]" style={`background:${fill}`} />)}
			More
		</p>
	</figcaption>
</figure>

<style>
	/* the day under the pointer gets a thin white outline */
	.graph-scroll rect[data-day]:hover {
		stroke: #fff;
		stroke-width: 1;
	}
	/* each edge fades only while there's more graph past it */
	.graph-scroll {
		--fade-l: 0px;
		--fade-r: 0px;
		mask-image: linear-gradient(to right, transparent, #000 var(--fade-l), #000 calc(100% - var(--fade-r)), transparent);
	}
</style>

<script>
	// on narrow screens, start scrolled to the most recent weeks, and fade whichever edges have more to scroll to
	document.querySelectorAll<HTMLElement>('[data-graph-scroll]').forEach((el) => {
		const fade = () => {
			const max = el.scrollWidth - el.clientWidth;
			el.style.setProperty('--fade-l', el.scrollLeft > 1 ? '40px' : '0px');
			el.style.setProperty('--fade-r', el.scrollLeft < max - 1 ? '40px' : '0px');
		};
		// stick to the latest weeks until someone scrolls back, also when the window is resized
		let atEnd = true;
		const toEnd = () => {
			if (atEnd) el.scrollLeft = el.scrollWidth;
			fade();
		};
		toEnd();
		el.addEventListener(
			'scroll',
			() => {
				atEnd = el.scrollLeft >= el.scrollWidth - el.clientWidth - 1;
				fade();
			},
			{ passive: true },
		);
		addEventListener('resize', toEnd);
	});

	// a small tooltip over the day under the pointer (a tap on phones): the count, then the date
	document.querySelectorAll<HTMLElement>('[data-graph]').forEach((fig) => {
		const tip = fig.querySelector<HTMLElement>('[data-graph-tip]')!;
		const scroller = fig.querySelector<HTMLElement>('[data-graph-scroll]')!;
		const hide = () => tip.classList.add('hidden');
		const show = (cell: SVGRectElement) => {
			const n = Number(cell.dataset.count);
			const what = n ? `${n.toLocaleString('en-US')} contribution${n === 1 ? '' : 's'}` : 'No contributions';
			tip.innerHTML = '';
			const b = document.createElement('span');
			b.className = n ? 'text-white' : '';
			b.textContent = what;
			tip.append(b, ` · ${cell.dataset.day}`);
			tip.classList.remove('hidden');
			// centred above the day, kept inside the figure
			const f = fig.getBoundingClientRect();
			const c = cell.getBoundingClientRect();
			const x = c.left + c.width / 2 - f.left - tip.offsetWidth / 2;
			tip.style.left = `${Math.max(4, Math.min(f.width - tip.offsetWidth - 4, x))}px`;
			tip.style.top = `${c.top - f.top - tip.offsetHeight - 6}px`;
		};
		fig.addEventListener('pointerover', (e) => {
			const cell = (e.target as Element).closest<SVGRectElement>('rect[data-day]');
			if (cell) show(cell);
			else hide();
		});
		// a finger "leaves" as soon as it lifts, so on touch the tip stays until a tap elsewhere or a scroll
		fig.addEventListener('pointerleave', (e) => e.pointerType !== 'touch' && hide());
		document.addEventListener('pointerdown', (e) => !fig.contains(e.target as Node) && hide());
		scroller.addEventListener('scroll', hide, { passive: true });
	});
</script>
