---
import updot from '../assets/logos/updot.svg';
import SectionTitle from './SectionTitle.astro';
import ToggleIcon from './ToggleIcon.astro';

// TODO: replace the [bracketed] placeholders. `open` decides whether an entry starts expanded.
const jobs = [
	{
		company: 'Updot',
		logo: updot,
		location: 'Bangalore, India',
		role: 'Software Developer',
		type: 'Full time',
		start: '[MM.YYYY]',
		end: 'Present',
		duration: '[duration]',
		points: ['[What you built or owned]', '[The impact it had]', '[Another responsibility]'],
		open: true,
	},
];
---

<section aria-labelledby="experience-title">
	<SectionTitle id="experience-title">Experience</SectionTitle>

	<ol class="divide-y-2 divide-line">
		{
			jobs.map((job) => (
				<li class="px-5 py-4">
					<details class="group" open={job.open}>
						<summary class="cursor-pointer list-none [&::-webkit-details-marker]:hidden">
							<div class="flex items-center gap-[14px]">
								<img src={job.logo.src} alt="" width="24" height="24" class="size-6 shrink-0" />
								<h3 class="flex-1 text-lg leading-7 tracking-[-0.01em] text-white">{job.company}</h3>
								<ToggleIcon />
							</div>
							<div class="pl-[38px]">
								<p class="mt-1 flex flex-wrap items-baseline justify-between gap-x-4 text-sm leading-7 tracking-[-0.01em]">
									<span class="text-white">{job.role}</span>
									<span class="text-muted">{job.location}</span>
								</p>
								<p class="text-sm leading-7 tracking-[-0.01em] text-muted">
									{job.type} | {job.start} - {job.end} | {job.duration}
								</p>
							</div>
						</summary>

						<ul class="mt-3 list-disc pl-[59px] text-sm leading-[26px] tracking-[-0.01em] text-white marker:text-tick">
							{job.points.map((point) => <li>{point}</li>)}
						</ul>
					</details>
				</li>
			))
		}
	</ol>
</section>
