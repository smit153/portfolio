---
// The colophon above the footer's lens: what the site is, how it was built and deployed, what it runs on, then
// the initials and socials. Build, date, versions and counts are read at build time.
import { execSync } from 'node:child_process';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import github from '../assets/icons/github.svg';
import linkedin from '../assets/icons/linkedin.svg';
import x from '../assets/icons/x.svg';
import { getPosts } from '../lib/posts';
import { getProjects } from '../lib/projects';
import PixelIcon from './PixelIcon.astro';

const DOMAIN = 'smiit.in';
const REPO = 'https://github.com/smit153/portfolio';

// the commit this build came from: Cloudflare's Workers Builds passes it in (though not always as a hash: a build
// started from the dashboard gave "main"), so only trust it when it looks like one; otherwise ask git
function commit() {
	const sha = process.env.WORKERS_CI_COMMIT_SHA ?? '';
	if (/^[0-9a-f]{7,40}$/i.test(sha)) return sha.slice(0, 7);
	try {
		return execSync('git rev-parse --short HEAD', { stdio: ['ignore', 'pipe', 'ignore'] }).toString().trim();
	} catch {
		return 'local';
	}
}
const build = commit();
const date = new Date().toISOString().slice(0, 10);

// the exact installed versions, not the ranges in package.json
const version = (pkg: string) => {
	try {
		return JSON.parse(readFileSync(join(process.cwd(), 'node_modules', pkg, 'package.json'), 'utf8')).version as string;
	} catch {
		return '?';
	}
};
const stack = ['astro', 'tailwindcss', '@astrojs/mdx', 'mermaid', '@rive-app/canvas'].map((p) => `${p}@${version(p)}`);

const posts = (await getPosts()).length;
const projects = (await getProjects()).length;

const socials = [
	{ label: 'X', href: 'https://x.com/smit_sojitra153', icon: x },
	{ label: 'GitHub', href: 'https://github.com/smit153', icon: github },
	{ label: 'LinkedIn', href: 'https://www.linkedin.com/in/smit-sojitra/', icon: linkedin },
];
const link = 'underline decoration-tick underline-offset-4 transition-colors hover:decoration-white';
const ext = { target: '_blank', rel: 'noopener noreferrer' };
---

<section aria-label="About this site" class="colophon relative mx-auto max-w-[768px] border-x-2 border-line text-body tracking-[-0.01em] text-white">
	<!-- domain and what the site is -->
	<div class="row flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 px-5 py-4">
		<a href="/" class="text-heading tracking-[-0.02em] text-white">{DOMAIN}</a>
		<p class="text-muted">A pixel-built portfolio, a notebook and a desk cat.</p>
	</div>

	<dl class="grid grid-cols-2 sm:grid-cols-4">
		<div>
			<dt>crafted by</dt>
			<dd><a href="https://x.com/smit_sojitra153" class={link} {...ext}>@smit_sojitra153</a></dd>
		</div>
		<div>
			<dt>build</dt>
			<dd><a href={`${REPO}/commit/${build}`} class={link} {...ext}>{build}</a></dd>
		</div>
		<div>
			<dt>date</dt>
			<dd>{date}</dd>
		</div>
		<div>
			<dt>contents</dt>
			<dd>{posts} posts · {projects} projects</dd>
		</div>

		<div>
			<dt>deployed on</dt>
			<dd>Cloudflare</dd>
		</div>
		<div>
			<dt>source code</dt>
			<dd><a href={REPO} class={link} {...ext}>GitHub</a></dd>
		</div>
		<div>
			<dt>license</dt>
			<dd><a href={`${REPO}/blob/main/LICENSE`} class={link} {...ext}>MIT License</a></dd>
		</div>
		<div>
			<dt>typeface</dt>
			<dd class="flex flex-col">
				<span>Söhne Mono</span>
				<span class="font-grape text-[18px] leading-[26px]">Grape Nuts</span>
				<span class="font-handwritten text-[20px] leading-[26px]">Caveat</span>
			</dd>
		</div>

		<div class="col-span-2">
			<dt>stack</dt>
			<dd class="flex flex-col">{stack.map((s) => <span>{s}</span>)}</dd>
		</div>
		<div>
			<dt>analytics</dt>
			<dd><a href="https://www.cloudflare.com/web-analytics/" class={link} {...ext}>Cloudflare Web Analytics</a></dd>
		</div>
		<div>
			<dt>for agents</dt>
			<dd class="flex flex-col items-start gap-1">
				<a href="/llms.txt" class={link}>llms.txt</a>
				<a href="/index.md" class={link}>index.md</a>
			</dd>
		</div>

	</dl>

	<!-- initials and socials -->
	<div class="row flex items-center justify-between px-5 py-3">
		<a href="/" aria-label="Home"><PixelIcon name="initials" class="text-white" /></a>
		<ul class="flex items-center gap-4">
			{
				socials.map(({ label, href, icon }) => (
					<li>
						<a href={href} aria-label={label} title={label} class="block opacity-70 transition-opacity hover:opacity-100" {...ext}>
							<img src={icon.src} alt="" width="18" height="18" class="size-[18px]" />
						</a>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	/* full-bleed hairlines between the rows, like the rest of the page */
	.row,
	dl {
		position: relative;
	}
	.row::after,
	dl::after {
		content: '';
		position: absolute;
		left: -50vw;
		right: -50vw;
		bottom: 0;
		height: 2px;
		background: var(--color-line);
	}
	/* the cells: a fine inner grid, label over value like the post meta blocks */
	dl {
		margin: 0;
	}
	dl > div {
		padding: 12px 20px 14px;
		border-bottom: 1px solid var(--color-line);
		border-right: 1px solid var(--color-line);
	}
	dt {
		margin-bottom: 4px;
		font-size: var(--text-tiny);
		line-height: var(--text-tiny--line-height);
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-tick);
	}
	dd {
		margin: 0;
	}
	/* no right border on the last cell of each row */
	@media (min-width: 640px) {
		dl > div:nth-child(4),
		dl > div:nth-child(8),
		dl > div:nth-child(11) {
			border-right: 0;
		}
		dl > div:nth-child(n + 9) {
			border-bottom: 0;
		}
	}
	@media (max-width: 639px) {
		dl > div:nth-child(2),
		dl > div:nth-child(4),
		dl > div:nth-child(6),
		dl > div:nth-child(8),
		dl > div:nth-child(9),
		dl > div:nth-child(11) {
			border-right: 0;
		}
		dl > div:nth-child(n + 10) {
			border-bottom: 0;
		}
	}
</style>
