---
// Interactive pixel-art desk scene rendered from public/rive/hero.riv
---

<div class="relative aspect-video w-full">
	<canvas
		id="hero-rive"
		class="block size-full outline-none [image-rendering:pixelated]"
		width="1280"
		height="720"
		tabindex="0"
		aria-label="Animated pixel-art desk scene"
	></canvas>
</div>

<script>
	import { Alignment, Fit, Layout, Rive, RuntimeLoader, type ViewModelInstance } from '@rive-app/canvas';
	import wasmUrl from '@rive-app/canvas/rive.wasm?url';
	// ua-parser-js 1.x (MIT; 2.x is AGPL)
	import UAParser from 'ua-parser-js';
	import keys from '../data/keyboard-keys.json';

	type Point = [number, number];

	// serve the runtime from our own bundle instead of the default CDN
	RuntimeLoader.setWasmUrl(wasmUrl);

	// mobile = phone or tablet; iPadOS reports a desktop Mac UA, so also count a touch Mac.
	// ?mobile=1 / ?mobile=0 overrides for testing. Phones and tablets have no hover, so the
	// scene opens the record player's lid by itself and keeps it open.
	const isMobile = (() => {
		const q = new URLSearchParams(location.search).get('mobile');
		if (q === '1' || q === '0') return q === '1';
		const type = new UAParser().getDevice().type;
		if (type === 'mobile' || type === 'tablet') return true;
		return /Macintosh/.test(navigator.userAgent) && navigator.maxTouchPoints > 1;
	})();

	// scene pixels: the artboard is 640x360 and fills the 16:9 canvas
	const W = 640;
	const H = 360;

	const inPoly = (p: Point, poly: Point[]) => {
		let c = false;
		for (let i = 0, j = poly.length - 1; i < poly.length; j = i++) {
			const [xi, yi] = poly[i];
			const [xj, yj] = poly[j];
			if (yi > p[1] !== yj > p[1] && p[0] < ((xj - xi) * (p[1] - yi)) / (yj - yi) + xi) c = !c;
		}
		return c;
	};
	const rect = (x0: number, y0: number, x1: number, y1: number): Point[] => [
		[x0, y0],
		[x1, y0],
		[x1, y1],
		[x0, y1],
	];

	// clickable regions (same shapes as the Rive hit areas) -> pointer cursor
	const BOOK_CLOSED = rect(486, 295, 557, 323);
	const BOOK_OPEN = rect(486, 300, 616, 325);
	const HOT: Point[][] = [
		[[8, 0], [295, 0], [295, 67], [173, 67], [173, 177], [8, 177]], // blinds (window minus the monitor)
		[[23, 298], [87, 254], [111, 250], [159, 259], [177, 265], [181, 281], [130, 325], [103, 323], [24, 313]], // vinyl
		[[131, 322], [165, 306], [199, 310], [199, 318], [160, 336], [131, 331]], // phone
		BOOK_CLOSED,
	];
	const BOARD = rect(312, 8, 508, 68); // corkboard: notes are draggable

	const keyAt = (p: Point) =>
		keys.findIndex(
			(k) => p[0] >= k.rect[0] && p[0] < k.rect[0] + k.rect[2] && p[1] >= k.rect[1] && p[1] < k.rect[1] + k.rect[3],
		);

	const canvas = document.querySelector<HTMLCanvasElement>('#hero-rive');

	if (canvas) {
		const toScene = (e: PointerEvent): Point => {
			const b = canvas.getBoundingClientRect();
			return [((e.clientX - b.left) * W) / b.width, ((e.clientY - b.top) * H) / b.height];
		};

		let vmi: ViewModelInstance | null = null;
		let monitorOn = true; // the state machine starts with the monitor on
		let selfFired = 0;
		let typed = '';
		let bookOpen = false;
		const down = new Set<number>();

		const setKeys = () => {
			const p = vmi?.string('keysDown');
			if (p) p.value = ',' + [...down].join(',') + ',';
		};
		const setTyped = (s: string) => {
			typed = s.slice(-600);
			const p = vmi?.string('typed');
			if (p) p.value = typed;
		};

		const type = (key: string, mods = false) => {
			if (!vmi || mods) return;
			if (!monitorOn) {
				// typing wakes the monitor
				monitorOn = true;
				selfFired++;
				vmi.trigger('toggleMonitor')?.trigger();
			}
			if (key === 'Backspace') setTyped(typed.slice(0, -1));
			else if (key === 'Enter') setTyped(typed + '\n');
			else if (key.length === 1) setTyped(typed + key);
		};

		const rive = new Rive({
			src: '/rive/hero.riv',
			canvas,
			stateMachine: 'State Machine 1',
			autoplay: true,
			autoBind: true,
			layout: new Layout({ fit: Fit.Contain, alignment: Alignment.Center }),
			onLoad: () => {
				rive.resizeDrawingSurfaceToCanvas();
				vmi = rive.viewModelInstance;
				if (!vmi) return;

				const mobile = vmi.boolean('isMobile');
				if (mobile) mobile.value = isMobile;

				// the monitor's power trigger fires from the Rive click listener or from typing; page-fired
				// toggles update monitorOn up front and skip their (async) echo
				vmi.trigger('toggleMonitor')?.on(() => {
					if (selfFired) {
						selfFired--;
						return;
					}
					monitorOn = !monitorOn;
					if (!monitorOn) setTyped('');
				});
				vmi.trigger('toggleBook')?.on(() => {
					bookOpen = !bookOpen;
					HOT[3] = bookOpen ? BOOK_OPEN : BOOK_CLOSED;
				});

				// shelf clock: the scene draws the digits from clockTime ("HHMM", 12-hour, leading space)
				const clock = vmi.string('clockTime');
				if (clock) {
					const tick = () => {
						const d = new Date();
						const h = d.getHours() % 12 || 12;
						clock.value = String(h).padStart(2, ' ') + String(d.getMinutes()).padStart(2, '0');
					};
					tick();
					setInterval(tick, 10_000);
				}
			},
		});

		window.addEventListener('resize', () => rive.resizeDrawingSurfaceToCanvas());

		// typing on the real keyboard presses the drawn keys and types on the monitor
		const isFormField = (t: EventTarget | null) =>
			t instanceof HTMLElement && (t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName));

		window.addEventListener('keydown', (e) => {
			if (isFormField(e.target)) return;
			const i = keys.findIndex((k) => k.code === e.code);
			if (i >= 0 && !down.has(i)) {
				down.add(i);
				setKeys();
			}
			// keep keys that would scroll or navigate inside the scene while it has focus
			if (document.activeElement === canvas && ['Space', 'Backspace', 'Quote', 'Slash'].includes(e.code)) {
				e.preventDefault();
			}
			type(e.key, e.ctrlKey || e.metaKey || e.altKey);
		});
		window.addEventListener('keyup', (e) => {
			if (down.delete(keys.findIndex((k) => k.code === e.code))) setKeys();
		});
		window.addEventListener('blur', () => {
			down.clear();
			setKeys();
		});

		// clicking a key on the drawn keyboard presses it and types its glyph (random letter for modifiers)
		let clicked = -1;
		canvas.addEventListener('pointerdown', (e) => {
			const i = keyAt(toScene(e));
			if (i < 0) return;
			clicked = i;
			down.add(i);
			setKeys();
			const k = keys[i];
			const key =
				k.code === 'Enter' || k.code === 'Backspace'
					? k.code
					: k.code === 'Space'
						? ' '
						: k.label.length === 1
							? k.label.toLowerCase()
							: String.fromCharCode(97 + Math.floor(Math.random() * 26));
			type(key);
		});
		const release = () => {
			if (clicked < 0) return;
			down.delete(clicked);
			clicked = -1;
			setKeys();
		};
		canvas.addEventListener('pointerup', release);
		canvas.addEventListener('pointerleave', release);

		canvas.addEventListener('pointermove', (e) => {
			const p = toScene(e);
			canvas.style.cursor =
				HOT.some((poly) => inPoly(p, poly)) || keyAt(p) >= 0 ? 'pointer' : inPoly(p, BOARD) ? 'grab' : 'default';
		});
	}
</script>
