---
// Interactive pixel-art desk scene rendered from src/assets/rive/hero.riv
// capture of the scene's first frame at Rive's 1528x859 (re-capture if hero.riv changes), saved as WebP quality 95
// (about 60 KB, visually lossless) with the clock's digits unlit, since the scene sets the real time once it runs
import poster from '../assets/images/hero-poster.webp';
---

<!-- the runtime and scene downloads start after the first paint (boot() in the script below) -->
<link rel="preload" href={poster.src} as="image" fetchpriority="high" />

<div class="relative aspect-video w-full">
	<!-- still of the first frame, shown until Rive draws. Both canvases draw at the hero's on-screen resolution (set
	     below) and the still is painted into a canvas of the same size, so the browser scales both through the same
	     path and the swap is invisible. -->
	<canvas
		data-hero-poster
		aria-hidden="true"
		width="1528"
		height="859"
		class="absolute inset-0 size-full [image-rendering:pixelated]"></canvas>
	<script is:inline define:vars={{ posterSrc: poster.src }}>
		// draw at the hero's on-screen resolution, capped at 1528x859: no sharper than the screen shows anyway, and on
		// phones and 1x screens Rive (sized to match in the script below) has far fewer pixels to draw every frame
		const c = document.querySelector('[data-hero-poster]');
		const w = Math.min(1528, Math.round(c.getBoundingClientRect().width * devicePixelRatio)) || 1528;
		c.width = w;
		c.height = Math.round((w * 859) / 1528);
		const img = new Image();
		img.src = posterSrc;
		img.decode().then(() => c.getContext('2d').drawImage(img, 0, 0, c.width, c.height), () => {});
	</script>
	<noscript>
		<img src={poster.src} alt="" class="absolute inset-0 size-full [image-rendering:pixelated]" />
	</noscript>
	<canvas
		id="hero-rive"
		class="relative block size-full opacity-0 outline-none [image-rendering:pixelated]"
		width="1528"
		height="859"
		tabindex="0"
		aria-label="Animated pixel-art desk scene"
	></canvas>

	<!-- handwritten notes in the side gutters (only where there's room); arrows stop at the column border -->
	<div class="hidden font-handwritten text-[22px] leading-[1.05] text-doodle select-none xl:block">
		<!-- left: points at the record player, with the sound toggle under it -->
		<p class="pointer-events-none absolute right-full top-[236px] mr-12 -rotate-6 whitespace-nowrap text-right">
			psst… drop the needle,<br />the record player<br />takes requests
		</p>
		<svg
			aria-hidden="true"
			class="pointer-events-none absolute right-full top-[318px] mr-1"
			width="56"
			height="40"
			viewBox="0 0 56 40"
			fill="none"
			stroke="currentColor"
			stroke-width="1.6"
			stroke-linecap="round"
			stroke-linejoin="round"
		>
			<path d="M4 4c6 10 15 19 27 24 7 3 14 4.5 21 5" />
			<path d="M45 27.5 52 33l-7.5 4.5" />
		</svg>

		<button
			id="hero-sound"
			type="button"
			aria-pressed="false"
			class="absolute right-full top-[380px] mr-12 flex -rotate-3 items-center gap-2 transition-opacity hover:opacity-70"
		>
			<svg
				aria-hidden="true"
				width="30"
				height="23"
				viewBox="0 0 40 30"
				fill="none"
				stroke="currentColor"
				stroke-width="1.6"
				stroke-linecap="round"
				stroke-linejoin="round"
			>
				<path d="M3.5 11.2c2.6-.3 5.2-.2 7.6 0l7.8-6.9c.8 6.6.9 14.1.2 21.3l-8-6.6c-2.5.3-5.1.2-7.7-.2-.6-2.5-.5-5.2.1-7.6Z" />
				<!-- display attributes (not classes) so the starting "off" state never depends on CSS having loaded -->
				<g data-on display="none">
					<path d="M23.5 10.5c1.8 2.6 1.9 6 .1 8.8" />
					<path d="M27.8 6.4c3.6 4.9 3.7 11.9.2 17.3" />
					<path d="M32.2 2.8c5.4 7.1 5.4 17 .1 24.6" />
				</g>
				<g data-off>
					<path d="M24.8 9.6 34.6 20.4" />
					<path d="M34.9 9.3c-3.4 3.4-6.6 7.2-10.1 11.4" />
				</g>
			</svg>
			<span data-label class="whitespace-nowrap text-lg">sound off</span>
		</button>

		<!-- right: the whole desk is interactive; arrow sits above the note and hooks up toward the desk -->
		<svg
			aria-hidden="true"
			class="pointer-events-none absolute left-full top-[262px] ml-1"
			width="60"
			height="48"
			viewBox="0 0 60 48"
			fill="none"
			stroke="currentColor"
			stroke-width="1.6"
			stroke-linecap="round"
			stroke-linejoin="round"
		>
			<path d="M50 45c-1.5-11-7-20-16-26.5C26 13 16 10 6 9" />
			<path d="M13.5 3.5 5.5 9l7.5 6" />
		</svg>
		<p class="pointer-events-none absolute left-full top-[318px] ml-12 rotate-[5deg] whitespace-nowrap">
			this whole desk is alive!<br />open the book, drag a note,<br />or just start typing
		</p>
	</div>
</div>

<script>
	// the runtime (and its 2 MB wasm) is loaded after the first paint, in boot() below
	import type { Rive, ViewModelInstance } from '@rive-app/canvas';
	import wasmUrl from '@rive-app/canvas/rive.wasm?url';
	import rivUrl from '../assets/rive/hero.riv?url';
	// ua-parser-js 1.x (MIT; 2.x is AGPL)
	import UAParser from 'ua-parser-js';
	import keys from '../data/keyboard-keys.json';

	type Point = [number, number];

	declare global {
		interface Window {
			__audioContexts?: AudioContext[];
			miniaudio?: { unlock?: () => void };
		}
	}

	// mobile = phone or tablet; iPadOS reports a desktop Mac UA, so also count a touch Mac.
	// ?mobile=1 / ?mobile=0 overrides for testing. Phones and tablets have no hover, so the
	// scene opens the record player's lid by itself and keeps it open.
	const isMobile = (() => {
		const q = new URLSearchParams(location.search).get('mobile');
		if (q === '1' || q === '0') return q === '1';
		const type = new UAParser().getDevice().type;
		if (type === 'mobile' || type === 'tablet') return true;
		return /Macintosh/.test(navigator.userAgent) && navigator.maxTouchPoints > 1;
	})();

	// scene pixels: the artboard is 640x360 and fills the 16:9 canvas
	const W = 640;
	const H = 360;

	const inPoly = (p: Point, poly: Point[]) => {
		let c = false;
		for (let i = 0, j = poly.length - 1; i < poly.length; j = i++) {
			const [xi, yi] = poly[i];
			const [xj, yj] = poly[j];
			if (yi > p[1] !== yj > p[1] && p[0] < ((xj - xi) * (p[1] - yi)) / (yj - yi) + xi) c = !c;
		}
		return c;
	};
	const rect = (x0: number, y0: number, x1: number, y1: number): Point[] => [
		[x0, y0],
		[x1, y0],
		[x1, y1],
		[x0, y1],
	];

	// clickable regions (same shapes as the Rive hit areas) -> pointer cursor
	const BOOK_CLOSED = rect(486, 295, 557, 323);
	const BOOK_OPEN = rect(486, 300, 616, 325);
	const HOT: Point[][] = [
		[[8, 0], [295, 0], [295, 67], [173, 67], [173, 177], [8, 177]], // blinds (window minus the monitor)
		[[23, 298], [87, 254], [111, 250], [159, 259], [177, 265], [181, 281], [130, 325], [103, 323], [24, 313]], // vinyl
		[[131, 322], [165, 306], [199, 310], [199, 318], [160, 336], [131, 331]], // phone
		BOOK_CLOSED,
	];
	const BOARD = rect(312, 8, 508, 68); // corkboard: notes are draggable

	const keyAt = (p: Point) =>
		keys.findIndex(
			(k) => p[0] >= k.rect[0] && p[0] < k.rect[0] + k.rect[2] && p[1] >= k.rect[1] && p[1] < k.rect[1] + k.rect[3],
		);

	const canvas = document.querySelector<HTMLCanvasElement>('#hero-rive');

	if (canvas) {
		const toScene = (e: PointerEvent): Point => {
			const b = canvas.getBoundingClientRect();
			return [((e.clientX - b.left) * W) / b.width, ((e.clientY - b.top) * H) / b.height];
		};

		let vmi: ViewModelInstance | null = null;
		let monitorOn = true; // the state machine starts with the monitor on
		let selfFired = 0;
		let typed = '';
		let bookOpen = false;

		// sounds play inside Rive (DeskAudio script); the page only stores the mute choice in the ViewModel
		let muted = false;
		try {
			muted = localStorage.getItem('desk-muted') === '1';
		} catch {}
		const soundBtn = document.querySelector<HTMLButtonElement>('#hero-sound');
		// browsers keep audio blocked until the first click/tap, and Rive's audio engine only unlocks on
		// those events, so the toggle shows "off" until then even if the visitor hasn't muted it
		let audioReady = false;
		const isOn = () => audioReady && !muted;
		const showSound = () => {
			if (!soundBtn) return;
			const on = isOn();
			soundBtn.setAttribute('aria-pressed', String(on));
			soundBtn.querySelector('[data-on]')?.setAttribute('display', on ? 'inline' : 'none');
			soundBtn.querySelector('[data-off]')?.setAttribute('display', on ? 'none' : 'inline');
			const label = soundBtn.querySelector('[data-label]');
			if (label) label.textContent = on ? 'sound on' : 'sound off';
		};
		const applyMuted = () => {
			const p = vmi?.boolean('muted');
			if (p) p.value = muted;
		};
		const unlockEvents = ['click', 'touchend'] as const;
		const markAudioReady = (render = true) => {
			if (audioReady) return;
			audioReady = true;
			unlockEvents.forEach((t) => document.removeEventListener(t, onFirstGesture, true));
			if (render) showSound();
		};
		// a press on the toggle itself is handled (and re-rendered) by its own click handler
		const onFirstGesture = (e: Event) => markAudioReady(!soundBtn?.contains(e.target as Node));
		unlockEvents.forEach((t) => document.addEventListener(t, onFirstGesture, true));
		showSound();
		soundBtn?.addEventListener('click', () => {
			// flip what the visitor sees: a first press on "sound off" (blocked, not muted) turns sound on
			const wasOn = soundBtn.getAttribute('aria-pressed') === 'true';
			muted = wasOn;
			showSound();
			applyMuted();
			try {
				localStorage.setItem('desk-muted', muted ? '1' : '0');
			} catch {}
			document.dispatchEvent(new Event('desk-muted')); // the desk cat listens for this too
		});
		const down = new Set<number>();

		const setKeys = () => {
			const p = vmi?.string('keysDown');
			if (p) p.value = ',' + [...down].join(',') + ',';
		};
		const setTyped = (s: string) => {
			typed = s.slice(-600);
			const p = vmi?.string('typed');
			if (p) p.value = typed;
		};

		const type = (key: string, mods = false) => {
			if (!vmi || mods) return;
			if (!monitorOn) {
				// typing wakes the monitor
				monitorOn = true;
				selfFired++;
				vmi.trigger('toggleMonitor')?.trigger();
			}
			if (key === 'Backspace') setTyped(typed.slice(0, -1));
			else if (key === 'Enter') setTyped(typed + '\n');
			else if (key.length === 1) setTyped(typed + key);
		};

		let rive: Rive | null = null;
		const boot = async () => {
			// fetch the wasm and the scene alongside the runtime's own code, rather than one after the other
			for (const href of [wasmUrl, rivUrl]) {
				const link = Object.assign(document.createElement('link'), { rel: 'preload', as: 'fetch', href, crossOrigin: 'anonymous' });
				document.head.append(link);
			}
			const { Alignment, Fit, Layout, Rive, RuntimeLoader } = await import('@rive-app/canvas');
			// serve the runtime from our own bundle instead of the default CDN
			RuntimeLoader.setWasmUrl(wasmUrl);
			// same drawing size as the poster, so the swap matches
			const poster = document.querySelector<HTMLCanvasElement>('[data-hero-poster]');
			if (poster) {
				canvas.width = poster.width;
				canvas.height = poster.height;
			}
			const r = new Rive({
				src: rivUrl,
				canvas,
				stateMachine: 'State Machine 1',
				autoplay: true,
				autoBind: true,
				layout: new Layout({ fit: Fit.Contain, alignment: Alignment.Center }),
				onLoad: () => {
					// the drawing surface keeps the poster's size (no resizeDrawingSurfaceToCanvas) so it matches the
					// still; once the first frame is drawn, swap them
					requestAnimationFrame(() =>
						requestAnimationFrame(() => {
							canvas.classList.remove('opacity-0');
							document.querySelector('[data-hero-poster]')?.remove();
						}),
					);
					new ResizeObserver(() => {
						const w = Math.min(1528, Math.round(canvas.getBoundingClientRect().width * devicePixelRatio));
						if (w <= canvas.width) return;
						canvas.width = w;
						canvas.height = Math.round((w * 859) / 1528);
						r.resizeToCanvas();
					}).observe(canvas);

					vmi = r.viewModelInstance;
					if (!vmi) return;

					const mobile = vmi.boolean('isMobile');
					if (mobile) mobile.value = isMobile;
					applyMuted();

					// the phone's random notification only runs while the scene is on screen (inView, in the scene's
					// DeskAudio script): off when less than a fifth of it shows or the tab is hidden. Music isn't affected.
					const inView = vmi.boolean('inView');
					if (inView) {
						let showing = true;
						const update = () => {
							const v = showing && document.visibilityState === 'visible';
							if (inView.value !== v) inView.value = v;
							canvas.dataset.inView = String(v); // visible in devtools, for checking
						};
						new IntersectionObserver(
							([e]) => {
								showing = e.intersectionRatio >= 0.2;
								update();
							},
							{ threshold: [0, 0.2] },
						).observe(canvas);
						document.addEventListener('visibilitychange', update);
						update();
					}

					// the monitor's power trigger fires from the Rive click listener or from typing; page-fired
					// toggles update monitorOn up front and skip their (async) echo
					vmi.trigger('toggleMonitor')?.on(() => {
						if (selfFired) {
							selfFired--;
							return;
						}
						monitorOn = !monitorOn;
						if (!monitorOn) setTyped('');
					});
					vmi.trigger('toggleBook')?.on(() => {
						bookOpen = !bookOpen;
						HOT[3] = bookOpen ? BOOK_OPEN : BOOK_CLOSED;
					});

					// shelf clock: the scene draws the digits from clockTime ("HHMM", 12-hour, leading space)
					const clock = vmi.string('clockTime');
					if (clock) {
						const tick = () => {
							const d = new Date();
							const h = d.getHours() % 12 || 12;
							clock.value = String(h).padStart(2, ' ') + String(d.getMinutes()).padStart(2, '0');
						};
						tick();
						setInterval(tick, 10_000);
					}
				},
			});
			rive = r;
		};
		// start once the page has loaded and its first paint is on screen, so fetching and compiling the runtime never
		// holds up the first frame (a requestAnimationFrame runs just before that frame paints, which is too early);
		// the poster (the same first frame) covers the hero until Rive draws
		const painted = new Promise<void>((resolve) => {
			if (performance.getEntriesByName('first-contentful-paint').length) return resolve();
			try {
				new PerformanceObserver((list, obs) => {
					if (list.getEntriesByName('first-contentful-paint').length) {
						obs.disconnect();
						resolve();
					}
				}).observe({ type: 'paint', buffered: true });
			} catch {
				resolve(); // no paint timing (old Safari): the load event alone
			}
		});
		const loaded = new Promise<void>((resolve) =>
			document.readyState === 'complete' ? resolve() : addEventListener('load', () => resolve(), { once: true }),
		);
		Promise.all([painted, loaded]).then(() => setTimeout(boot, 0));

		// Rive's audio only unlocks on click/touchend/pointerdown, so a first key press stays silent.
		// Unlock it ourselves inside the key gesture: resume every AudioContext (tracked by the inline
		// script in Layout.astro), poke the runtime's internal miniaudio unlock if it exists, and set the
		// public `volume`, which makes the runtime re-run its audio check right away.
		const RIVE_VOLUME = 1; // runtime default; match it if we ever change rive.volume
		const NOT_A_GESTURE = new Set([
			'Escape', 'Shift', 'Control', 'Alt', 'AltGraph', 'Meta', 'OS', 'CapsLock', 'NumLock', 'ScrollLock',
			'Fn', 'FnLock', 'Hyper', 'Super', 'Symbol', 'SymbolLock', 'Dead', 'Unidentified',
		]);
		const audioContexts = () => window.__audioContexts ?? [];
		const audioUnlocked = () => !!window.miniaudio && audioContexts().every((c) => c.state !== 'suspended');
		const unlockAudioOnKey = (e: KeyboardEvent) => {
			if (!e.isTrusted || e.repeat || !e.key || NOT_A_GESTURE.has(e.key)) return;
			if (navigator.userActivation && !navigator.userActivation.isActive) return;
			for (const c of audioContexts()) if (c.state === 'suspended') c.resume().catch(() => {});
			const mini = window.miniaudio; // runtime internal, may disappear in an update
			if (mini && typeof mini.unlock === 'function') {
				try {
					mini.unlock();
				} catch {}
			}
			if (rive) rive.volume = RIVE_VOLUME;
			markAudioReady();
			// stay subscribed until Rive's output exists and nothing is suspended (Safari may need a second key)
			setTimeout(() => {
				if (audioUnlocked()) window.removeEventListener('keydown', unlockAudioOnKey, true);
			}, 250);
		};
		window.addEventListener('keydown', unlockAudioOnKey, true);

		// typing on the real keyboard presses the drawn keys and types on the monitor
		const isFormField = (t: EventTarget | null) =>
			t instanceof HTMLElement && (t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName));

		window.addEventListener('keydown', (e) => {
			if (isFormField(e.target)) return;
			const i = keys.findIndex((k) => k.code === e.code);
			if (i >= 0 && !down.has(i)) {
				down.add(i);
				setKeys();
			}
			// keep keys that would scroll or navigate inside the scene while it has focus
			if (document.activeElement === canvas && ['Space', 'Backspace', 'Quote', 'Slash'].includes(e.code)) {
				e.preventDefault();
			}
			type(e.key, e.ctrlKey || e.metaKey || e.altKey);
		});
		window.addEventListener('keyup', (e) => {
			if (down.delete(keys.findIndex((k) => k.code === e.code))) setKeys();
		});
		window.addEventListener('blur', () => {
			down.clear();
			setKeys();
		});

		// clicking a key on the drawn keyboard presses it and types its glyph (random letter for modifiers)
		let clicked = -1;
		canvas.addEventListener('pointerdown', (e) => {
			const i = keyAt(toScene(e));
			if (i < 0) return;
			clicked = i;
			down.add(i);
			setKeys();
			const k = keys[i];
			const key =
				k.code === 'Enter' || k.code === 'Backspace'
					? k.code
					: k.code === 'Space'
						? ' '
						: k.label.length === 1
							? k.label.toLowerCase()
							: String.fromCharCode(97 + Math.floor(Math.random() * 26));
			type(key);
		});
		const release = () => {
			if (clicked < 0) return;
			down.delete(clicked);
			clicked = -1;
			setKeys();
		};
		canvas.addEventListener('pointerup', release);
		canvas.addEventListener('pointerleave', release);

		canvas.addEventListener('pointermove', (e) => {
			const p = toScene(e);
			canvas.style.cursor =
				HOT.some((poly) => inPoly(p, poly)) || keyAt(p) >= 0 ? 'pointer' : inPoly(p, BOARD) ? 'grab' : 'default';
		});
	}
</script>
