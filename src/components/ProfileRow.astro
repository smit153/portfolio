---
// The avatar, name and title. From tablet up the résumé and socials sit in a box at the right (ProfileLinks);
// on phones the home page shows them as a row further down, after the contact details.
import { Image } from 'astro:assets';
import avatar from '../assets/images/avatar-glasses.png';
import ProfileLinks from './ProfileLinks.astro';
---

<section class="relative [--avatar:96px] sm:[--avatar:150px]">
	<div class="relative h-[101px]">
		<!-- top hairline: full bleed, broken under the avatar -->
		<span aria-hidden="true" class="absolute right-full top-0 h-[2px] w-[50vw] bg-line"></span>
		<span
			aria-hidden="true"
			class="absolute left-[calc(var(--avatar)+1px)] top-0 h-[2px] w-[calc(100%-var(--avatar)-1px+50vw)] bg-line"
		></span>
		<span aria-hidden="true" class="absolute inset-y-0 left-[calc(var(--avatar)+1px)] w-[2px] bg-line"></span>

		<Image
			src={avatar}
			alt="Pixel-art portrait of Smit Sojitra"
			width={300}
			height={300}
			class="absolute bottom-0 left-px z-10 size-(--avatar) rounded-full object-cover [image-rendering:pixelated]"
		/>

		<!-- the name stays on one line -->
		<div class="pl-[calc(var(--avatar)+17px)] pr-5 pt-3 sm:pr-[188px]">
			<h1 class="truncate whitespace-nowrap text-base font-medium leading-normal tracking-[-0.02em] text-white sm:text-[22px] sm:leading-[1.5]">
				Smit Sojitra
			</h1>
			<!-- on a phone the title may wrap to a second line rather than be cut off -->
			<p class="text-body tracking-[-0.04em] text-muted sm:truncate sm:whitespace-nowrap">
				Software Developer <span class="text-tick">|</span> <span class="whitespace-nowrap">AI Engineer</span>
			</p>
		</div>
	</div>

	<ProfileLinks layout="box" class="max-sm:hidden" />
</section>
