---
import { Image } from 'astro:assets';
import avatar from '../assets/images/avatar-portrait.png';
import github from '../assets/icons/github.svg';
import linkedin from '../assets/icons/linkedin.svg';
import x from '../assets/icons/x.svg';
import resume from '../assets/icons/resume.svg';
import devto from '../assets/icons/devto.svg';

// TODO: drop the PDF into public/ under this name
const RESUME_HREF = '/resume.pdf';

// TODO: real profile URLs
const socials = [
	{ label: 'GitHub', href: 'https://github.com/smit153', icon: github, frame: 'size-[26px]', inset: 'inset-0' },
	{ label: 'LinkedIn', href: 'https://www.linkedin.com/in/smit-sojitra/', icon: linkedin, frame: 'size-[26px]', inset: 'inset-0' },
	{ label: 'X', href: 'https://x.com/smit_sojitra153', icon: x, frame: 'size-[26px]', inset: 'inset-0' },
	{ label: 'DEV', href: 'https://dev.to/smit153', icon: devto, frame: 'h-[28px] w-[31px]', inset: 'inset-0' },
];
---

<section class="relative h-[101px] [--avatar:96px] sm:[--avatar:150px]">
	<!-- top hairline: full bleed, broken under the avatar -->
	<span aria-hidden="true" class="absolute right-full top-0 h-[2px] w-[50vw] bg-line"></span>
	<span
		aria-hidden="true"
		class="absolute left-[calc(var(--avatar)+1px)] top-0 h-[2px] w-[calc(100%-var(--avatar)-1px+50vw)] bg-line"
	></span>
	<span aria-hidden="true" class="absolute inset-y-0 left-[calc(var(--avatar)+1px)] w-[2px] bg-line"></span>

	<Image
		src={avatar}
		alt="Pixel-art portrait of Smit Sojitra"
		width={300}
		height={300}
		class="absolute bottom-0 left-px z-10 size-(--avatar) rounded-full object-cover [image-rendering:pixelated]"
	/>

	<div class="pl-[calc(var(--avatar)+17px)] pr-[132px] pt-3 sm:pr-[188px]">
		<h1 class="text-base font-medium leading-normal tracking-[-0.02em] text-white sm:text-[22px] sm:leading-[1.5]">
			Smit Sojitra
		</h1>
		<p class="text-sm leading-normal tracking-[-0.04em] text-muted sm:text-lg">Software Developer</p>
	</div>

	<!-- links box: resume on top, socials below -->
	<div class="absolute inset-y-0 right-0 flex w-[124px] flex-col sm:w-[180px] border-l-2 border-line pt-[2px]">
		<a
			href={RESUME_HREF}
			target="_blank"
			rel="noopener noreferrer"
			class="flex flex-1 items-center justify-end gap-2 border-b-2 border-dotted pr-2.5 border-line text-white transition-opacity hover:opacity-70 "
		>
			<img src={resume.src} alt="" width="16" height="20" class="block size-5" />
			<span class="leading-none tracking-[0.04em] [font-variant:small-caps]  text-lg">Résumé</span>
		</a>

		<!-- phones: 2x2 grid scaled down to fit the cell; sm+: one row -->
		<ul
			class="grid flex-1 grid-cols-2 place-content-center place-items-center gap-x-2 gap-y-1 max-sm:scale-[0.6] sm:flex sm:items-center sm:justify-center sm:gap-3"
		>
			{
				socials.map(({ label, href, icon, frame, inset }) => (
					<li class="flex">
						<a
							href={href}
							aria-label={label}
							target="_blank"
							rel="noopener noreferrer"
							class={`relative block ${frame} transition-opacity hover:opacity-70`}
						>
							<span class={`absolute ${inset}`}>
								<img src={icon.src} alt="" class="absolute inset-0 block size-full max-w-none" />
							</span>
						</a>
					</li>
				))
			}
		</ul>
	</div>
</section>
