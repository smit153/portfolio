---
// Full-width footer: the colophon in the page column, then the dot-matrix lens (see src/lib/lens-field.ts).
import Colophon from './Colophon.astro';
---

<!-- no top border: the ascii strip above already ends in a line -->
<footer class="relative bg-ink">
	<Colophon />
	<canvas data-lens-field aria-hidden="true" class="block w-full touch-pan-y"></canvas>
</footer>

<script>
	import { startLensField } from '../lib/lens-field';

	const canvas = document.querySelector<HTMLCanvasElement>('[data-lens-field]');
	if (canvas) startLensField(canvas, 'SMIT SOJITRA');
</script>
