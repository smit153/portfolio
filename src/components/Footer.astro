---
// Full-width footer: the colophon in the page column, then the name in pixel blocks that glow where the pointer
// passes (see src/lib/afterglow-field.ts).
import Colophon from './Colophon.astro';
---

<!-- no top border: the ascii strip above already ends in a line -->
<footer class="relative bg-ink">
	<Colophon />
	<canvas data-name-field aria-hidden="true" class="block w-full touch-pan-y"></canvas>
</footer>

<script>
	import { startAfterglowField } from '../lib/afterglow-field';

	const canvas = document.querySelector<HTMLCanvasElement>('[data-name-field]');
	if (canvas) startAfterglowField(canvas, 'SMIT SOJITRA');
</script>
