---
// Home: the featured projects as a file tree (see src/data/projects.ts), with a link to the full list.
import { featuredProjects } from '../data/projects';
import ProjectTree from './ProjectTree.astro';
import SectionTitle from './SectionTitle.astro';
import SeeAll from './SeeAll.astro';
---

<section aria-labelledby="projects-title">
	<SectionTitle id="projects-title">Projects</SectionTitle>
	<ProjectTree projects={featuredProjects} />
	<SeeAll href="/projects">All projects</SeeAll>
</section>
