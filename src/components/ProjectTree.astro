---
// Projects as a list: one row per project (its pixel icon, name, a short line, status), each opening into a small
// file tree of its README (summary), NOTES (points), stack and links (its case study page, repo, live site).
// Featured projects start open; any number can be open at once. A full-width hairline separates the projects, like the page's other lines.
// The files' connector lines: the list draws a trunk down its left, and every file an elbow into it.
import arrowUp from '../assets/icons/arrow-up.svg';
import type { Project } from '../lib/projects';
import Pill from './Pill.astro';
import PixelIcon from './PixelIcon.astro';

interface Props {
	projects: Project[];
}
const { projects } = Astro.props;
---

<div class="tree px-5">
	<ul>
		{
			projects.map(({ data: p, href }) => (
				<li class="proj">
					<details class="group" open={p.featured}>
						<summary>
							<PixelIcon name={p.icon} class="ico" />
							<span class="min-w-0">
								<span class="name">{p.title}</span>
								<span class="tagline">{p.tagline}</span>
							</span>
							<span class="side">
								{p.featured && <PixelIcon name="star" scale={1} class="text-white" />}
								<span>{p.status}</span>
							</span>
						</summary>
						<ul class="files">
							<li>
								<div class="file">
									<span class="fname">README.md</span>
									<span class="fval">{p.summary}</span>
								</div>
							</li>
							<li>
								<div class="file">
									<span class="fname">NOTES.md</span>
									<ul class="points fval">
										{p.notes.map((point) => (
											<li>{point}</li>
										))}
									</ul>
								</div>
							</li>
							<li>
								<div class="file">
									<span class="fname">stack</span>
									<ul class="skills flex flex-wrap gap-[3px]" aria-label="Skills">
										{p.stack.map((skill) => (
											<li>
												<Pill>{skill}</Pill>
											</li>
										))}
									</ul>
								</div>
							</li>
							<li>
								<div class="file">
									<span class="fname">links</span>
									<span class="fval flex flex-wrap gap-x-4 gap-y-1">
										<a href={href} class="link">
											case study <img src={arrowUp.src} alt="" width="13" height="14" class="rotate-90" />
										</a>
										{p.source && (
											<a href={p.source} target="_blank" rel="noopener noreferrer" class="link">
												repo <img src={arrowUp.src} alt="" width="13" height="14" class="rotate-[38deg]" />
											</a>
										)}
										{p.live && (
											<a href={p.live} target="_blank" rel="noopener noreferrer" class="link">
												live <img src={arrowUp.src} alt="" width="13" height="14" class="rotate-[38deg]" />
											</a>
										)}
									</span>
								</div>
							</li>
						</ul>
					</details>
				</li>
			))
		}
	</ul>
</div>

<style>
	.tree ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.tree li {
		position: relative;
		padding-left: 30px;
	}
	/* the trunk down the left of each item; the last item's stops at its elbow */
	.tree li::before {
		content: '';
		position: absolute;
		left: 9px;
		top: 0;
		bottom: 0;
		width: 2px;
		background: var(--color-line);
		transition: background-color 0.2s;
	}
	.tree li:last-child::before {
		bottom: auto;
		height: 16px;
	}
	/* the elbow from the trunk into the item */
	.tree li::after {
		content: '';
		position: absolute;
		left: 9px;
		top: 15px;
		width: 16px;
		height: 2px;
		background: var(--color-line);
		transition:
			background-color 0.2s,
			width 0.2s;
	}
	/* projects: no connector lines of their own, just a full-width hairline between them */
	.tree .proj {
		padding: 10px 0 8px;
	}
	.tree .proj::before,
	.tree .proj::after {
		content: none;
	}
	.tree .proj + .proj::before {
		content: '';
		left: -50vw;
		right: -50vw;
		top: 0;
		bottom: auto;
		width: auto;
		height: 2px;
		background: var(--color-line);
	}

	summary {
		position: relative;
		z-index: 0; /* keeps the hover highlight (z-index -1) inside the row */
		display: grid;
		grid-template-columns: 24px 1fr auto;
		gap: 12px;
		align-items: start;
		padding: 6px 0 8px;
		list-style: none;
		cursor: pointer;
	}
	summary::-webkit-details-marker {
		display: none;
	}
	summary:focus-visible {
		outline: none;
	}
	/* a highlight that sweeps in from the left on hover */
	summary::before {
		content: '';
		position: absolute;
		inset: 1px -8px 1px -6px;
		z-index: -1;
		background: #111113;
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.25s ease;
	}
	summary:hover::before,
	summary:focus-visible::before {
		transform: scaleX(1);
	}
	/* centred on the elbow */
	summary :global(.ico) {
		margin-top: 0;
		color: var(--color-tick);
		transition: color 0.2s;
	}
	summary:hover :global(.ico),
	details[open] :global(.ico) {
		color: #fff;
	}
	.name {
		display: inline-block;
		font-size: var(--text-heading);
		line-height: var(--text-heading--line-height);
		letter-spacing: -0.01em;
		color: #fff;
		transition: transform 0.2s ease;
	}
	.name::after {
		content: '/';
		color: var(--color-tick);
	}
	summary:hover .name {
		transform: translateX(3px);
	}
	/* the short line shows while it's closed; open, README.md says it in full */
	.tagline {
		display: block;
		margin-top: 2px;
		overflow: hidden;
		white-space: nowrap;
		text-overflow: ellipsis;
		font-size: var(--text-body);
		line-height: var(--text-body--line-height);
		letter-spacing: -0.04em;
		color: var(--color-muted);
	}
	details[open] .tagline {
		display: none;
	}
	.side {
		display: flex;
		align-items: center;
		gap: 8px;
		font-size: var(--text-body);
		line-height: var(--text-body--line-height);
		color: var(--color-tick);
		transition: color 0.2s;
	}
	summary:hover .side {
		color: var(--color-muted);
	}

	/* the files: a nested list with its own trunk, hanging from the project's icon */
	.files {
		margin-bottom: 6px !important;
	}
	.files > li {
		padding-left: 34px;
	}
	.files > li::before,
	.files > li::after {
		background: #262727;
	}
	.file {
		display: grid;
		grid-template-columns: 110px 1fr;
		gap: 12px;
		align-items: baseline;
		padding: 5px 0;
	}
	.fname {
		font-size: var(--text-small);
		line-height: var(--text-small--line-height);
		color: var(--color-muted);
	}
	.fval {
		font-size: var(--text-body);
		line-height: var(--text-body--line-height);
		letter-spacing: -0.01em;
		color: #fff;
	}
	/* NOTES.md points: plain dashes, none of the tree's connector lines */
	.points > li {
		padding: 0 0 2px 16px;
	}
	.points > li::before {
		content: '-';
		left: 2px;
		bottom: auto;
		width: auto;
		height: auto;
		background: none;
		color: var(--color-tick);
	}
	.points > li::after {
		content: none;
	}
	.skills > li {
		padding: 0;
	}
	.skills > li::before,
	.skills > li::after {
		content: none;
	}
	.link {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		border-bottom: 1px solid var(--color-tick);
		transition: border-color 0.2s;
	}
	.link:hover {
		border-color: #fff;
	}
	@media (prefers-reduced-motion: reduce) {
		.tree *,
		.tree *::before,
		.tree *::after {
			transition: none !important;
		}
	}
</style>
