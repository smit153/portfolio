---
// Projects as a list: one row per project (its pixel icon, name, a short line, status), each opening into a small
// file tree of its README (summary), NOTES (points), stack and links (its case study page, repo, live site).
// Featured projects start open; any number can be open at once. A full-width hairline separates the projects, like the page's other lines.
// The files' connector lines: the list draws a trunk down its left, and every file a square elbow into it. Pointing at a
// file lights the trunk from the top down to it and its elbow; opening a project folds the files out.
import arrowUp from '../assets/icons/arrow-up.svg';
import type { Project } from '../lib/projects';
import Pill from './Pill.astro';
import PixelIcon from './PixelIcon.astro';
import ToggleIcon from './ToggleIcon.astro';

interface Props {
	projects: Project[];
}
const { projects } = Astro.props;
---

<div class="tree px-5">
	<ul>
		{
			projects.map(({ data: p, href }) => (
				<li class="proj">
					<details class="group" open={p.featured}>
						<summary>
							<PixelIcon name={p.icon} class="ico" />
							<span class="min-w-0">
								<span class="name">{p.title}</span>
								<span class="tagline">{p.tagline}</span>
							</span>
							<span class="side">
								{p.featured && <PixelIcon name="star" scale={1} class="text-white" />}
								<span>{p.status}</span>
								<ToggleIcon />
							</span>
						</summary>
						<ul class="files">
							<li>
								<div class="file">
									<span class="fname">README.md</span>
									<span class="fval">{p.summary}</span>
								</div>
							</li>
							<li>
								<div class="file">
									<span class="fname">NOTES.md</span>
									<ul class="points fval">
										{p.notes.map((point) => (
											<li>{point}</li>
										))}
									</ul>
								</div>
							</li>
							<li>
								<div class="file">
									<span class="fname">stack</span>
									<ul class="skills flex flex-wrap gap-[3px]" aria-label="Skills">
										{p.stack.map((skill) => (
											<li>
												<Pill>{skill}</Pill>
											</li>
										))}
									</ul>
								</div>
							</li>
							<li>
								<div class="file">
									<span class="fname">links</span>
									<span class="fval flex flex-wrap gap-x-4 gap-y-1">
										<a href={href} class="link">
											case study <img src={arrowUp.src} alt="" width="13" height="14" class="rotate-90" />
										</a>
										{p.source && (
											<a href={p.source} target="_blank" rel="noopener noreferrer" class="link">
												repo <img src={arrowUp.src} alt="" width="13" height="14" class="rotate-[38deg]" />
											</a>
										)}
										{p.live && (
											<a href={p.live} target="_blank" rel="noopener noreferrer" class="link">
												live <img src={arrowUp.src} alt="" width="13" height="14" class="rotate-[38deg]" />
											</a>
										)}
									</span>
								</div>
							</li>
						</ul>
					</details>
				</li>
			))
		}
	</ul>
</div>

<style>
	.tree ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.tree li {
		position: relative;
		padding-left: 30px;
	}
	/* the trunk down the left of each item; the last item's stops at its elbow */
	.tree li::before {
		content: '';
		position: absolute;
		left: 9px;
		top: 0;
		bottom: 0;
		width: 2px;
		background: var(--color-line);
		transition: background-color 0.2s;
	}
	.tree li:last-child::before {
		bottom: auto;
		height: 16px;
	}
	/* the elbow from the trunk into the item */
	.tree li::after {
		content: '';
		position: absolute;
		left: 9px;
		top: 15px;
		width: 16px;
		height: 2px;
		background: var(--color-line);
		transition:
			background-color 0.2s,
			width 0.2s;
	}
	/* projects: no connector lines of their own, just a full-width hairline between them */
	.tree .proj {
		padding: 10px 0 8px;
	}
	.tree .proj::before,
	.tree .proj::after {
		content: none;
	}
	.tree .proj + .proj::before {
		content: '';
		left: -50vw;
		right: -50vw;
		top: 0;
		bottom: auto;
		width: auto;
		height: 2px;
		background: var(--color-line);
	}

	summary {
		position: relative;
		display: grid;
		grid-template-columns: 24px 1fr auto;
		gap: 12px;
		align-items: start;
		padding: 6px 0 8px;
		list-style: none;
		cursor: pointer;
		transition: opacity 0.2s;
	}
	/* hover just dims the row, like the blog arrows */
	summary:hover {
		opacity: 0.7;
	}
	summary::-webkit-details-marker {
		display: none;
	}
	summary:focus-visible {
		outline: none;
	}
	/* centred on the elbow */
	summary :global(.ico) {
		margin-top: 0;
		color: var(--color-tick);
		transition: color 0.2s;
	}
	details[open] :global(.ico) {
		color: #fff;
	}
	.name {
		display: inline-block;
		font-size: var(--text-heading);
		line-height: var(--text-heading--line-height);
		letter-spacing: -0.01em;
		color: #fff;
	}
	.name::after {
		content: '/';
		color: var(--color-tick);
	}
	/* the short line shows while it's closed; open, README.md says it in full */
	.tagline {
		display: block;
		margin-top: 2px;
		overflow: hidden;
		white-space: nowrap;
		text-overflow: ellipsis;
		font-size: var(--text-body);
		line-height: var(--text-body--line-height);
		letter-spacing: -0.04em;
		color: var(--color-muted);
	}
	details[open] .tagline {
		display: none;
	}
	.side {
		display: flex;
		align-items: center;
		gap: 8px;
		font-size: var(--text-body);
		line-height: var(--text-body--line-height);
		color: var(--color-tick);
	}

	/* opening a project folds its files out instead of snapping (browsers without ::details-content just snap) */
	.proj details {
		interpolate-size: allow-keywords;
	}
	.proj details::details-content {
		block-size: 0;
		overflow: clip;
		transition:
			block-size 0.18s cubic-bezier(0.23, 1, 0.32, 1),
			content-visibility 0.18s allow-discrete;
	}
	.proj details[open]::details-content {
		block-size: auto;
	}

	/* the files: a nested list with its own trunk, hanging from the project's icon. Each trunk piece has a white fill
	   that grows down it. */
	.files {
		--wire: #262727;
		--lit: #444; /* a quiet step up from the wire, not something that pulls the eye */
		margin-bottom: 6px !important;
	}
	.files > li {
		padding-left: 34px;
	}
	.files > li::before {
		background: linear-gradient(var(--lit), var(--lit)) top / 2px 0 no-repeat, var(--wire);
		transition: none;
	}
	/* the elbow starts beside the trunk instead of over it, so a lit trunk has no dark notch at each junction */
	.files > li::after {
		left: 11px;
		width: 14px;
		background: var(--wire);
		transition: none;
	}
	/* pointing at a file: the trunk lights from the top through the files above it, down to its own elbow, and the
	   elbow lights, all at once */
	.files > li:has(~ li:hover)::before {
		background-size: 2px 100%;
	}
	.files > li:hover::before {
		background-size: 2px 17px; /* down through the elbow's joint */
	}
	.files > li:hover::after {
		background-color: var(--lit);
	}
	.file {
		display: grid;
		grid-template-columns: 110px 1fr;
		gap: 12px;
		align-items: baseline;
		padding: 5px 0;
	}
	/* on phones the file name sits above its contents, so the text gets the whole width */
	@media (max-width: 560px) {
		.file {
			grid-template-columns: 1fr;
			gap: 2px;
		}
	}
	.fname {
		font-size: var(--text-small);
		line-height: var(--text-small--line-height);
		color: var(--color-muted);
	}
	.fval {
		font-size: var(--text-body);
		line-height: var(--text-body--line-height);
		letter-spacing: -0.01em;
		color: #fff;
	}
	/* NOTES.md points: plain dashes, none of the tree's connector lines */
	.points > li {
		padding: 0 0 2px 16px;
	}
	.points > li::before {
		content: '-';
		left: 2px;
		bottom: auto;
		width: auto;
		height: auto;
		background: none;
		color: var(--color-tick);
	}
	.points > li::after {
		content: none;
	}
	.skills > li {
		padding: 0;
	}
	.skills > li::before,
	.skills > li::after {
		content: none;
	}
	.link {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		border-bottom: 1px solid var(--color-tick);
		transition: border-color 0.2s;
	}
	.link:hover {
		border-color: #fff;
	}
	@media (prefers-reduced-motion: reduce) {
		.tree *,
		.tree *::before,
		.tree *::after {
			transition: none !important;
		}
	}
</style>
