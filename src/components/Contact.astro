---
import SectionTitle from './SectionTitle.astro';

// TODO: replace the [bracketed] placeholders and the booking link
const BOOK_A_CALL = '#';
---

<section aria-labelledby="contact-title">
	<SectionTitle id="contact-title">[Contact title]</SectionTitle>

	<!-- text on the left, the call to action on the right (stacked on small screens), both kept up top: the empty
	     space below is the desk cat's stage, since it walks along the strip right under this section -->
	<div class="flex flex-col gap-5 px-5 pb-24 pt-6 sm:flex-row sm:items-start sm:justify-between">
		<div class="flex flex-col gap-1.5">
			<h3 class="text-lg tracking-[-0.04em] text-white">Let’s build something together</h3>
			<p class="text-sm tracking-[-0.04em] text-muted">[A line about the work you’re open to]</p>
		</div>
		<a
			href={BOOK_A_CALL}
			class="inline-flex h-8 w-fit shrink-0 items-center border border-line bg-ink px-[15px] text-sm tracking-[-0.01em] text-[#f3f4f6] transition-colors hover:border-tick"
		>
			Book a Call
		</a>
	</div>
</section>
