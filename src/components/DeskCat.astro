---
// Starts the desk cat. It lives on [data-pet-floor] lines and calls the [data-pet-home] floor home
// (on the site, the ASCII strip at the bottom: <AsciiField petHome />).
---

<script>
	import { startDeskCat } from '../lib/desk-cat';
	import { onPage } from '../lib/on-page';

	onPage((signal) => startDeskCat(signal));
</script>
