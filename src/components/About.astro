---
// The short version of who I am, summarised from my LinkedIn About.
import { about } from '../data/profile';
import SectionTitle from './SectionTitle.astro';

const projects = [
	{ name: 'Oshi', href: '/projects/oshi', note: 'a sliding puzzle you can play without JavaScript' },
	{ name: 'ModelMux', href: '/projects/modelmux', note: 'coding CLIs behind an OpenAI-compatible API' },
	{ name: 'Doodlesy', href: '/projects/doodlesy', note: 'multiplayer draw and guess' },
];
const link = 'underline decoration-tick underline-offset-4 transition-colors hover:decoration-white';
---

<section aria-labelledby="about-title">
	<SectionTitle id="about-title">So, who am I?</SectionTitle>

	<ul class="list-disc space-y-2 py-6 pl-10 pr-5 text-body tracking-[-0.01em] text-white marker:text-tick">
		{about.map((point) => <li>{point}</li>)}
		<li>
			Creator of{' '}
			{
				projects.map(({ name, href, note }, i) => (
					<>
						{i === projects.length - 1 ? 'and ' : ''}
						<a href={href} class={link}>
							{name}
						</a>{' '}
						({note}){i < projects.length - 1 ? ', ' : '.'}
					</>
				))
			}
		</li>
	</ul>
</section>
