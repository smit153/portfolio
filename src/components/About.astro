---
// The short version of who I am, summarised from my LinkedIn About.
import { about } from '../data/profile';
import MarginNote from './MarginNote.astro';
import SectionTitle from './SectionTitle.astro';
---

<section aria-labelledby="about-title" class="relative">
	<SectionTitle id="about-title">So, who am I?</SectionTitle>

	<MarginNote side="left" top="72px">
		Short version:<br />I fix things I broke.
	</MarginNote>

	<ul class="list-disc space-y-2 py-6 pl-10 pr-5 text-body tracking-[-0.01em] text-white marker:text-tick">
		{about.map((point) => <li>{point}</li>)}
	</ul>
</section>
