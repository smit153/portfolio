---
// Long-session-cost figure: five requests, each re-sending the last one (from cache) plus a new tail.
const unit = 13;
const bars = Array.from({ length: 5 }, (_, i) => ({
	y: 34 + i * 32,
	cached: (4 + i * 3) * unit,
	fresh: 3 * unit,
}));
---

<figure>
	<svg viewBox="0 0 680 230" role="img" aria-labelledby="f2t f2d">
		<title id="f2t">Every request re-sends the whole conversation</title>
		<desc id="f2d">Five requests drawn as horizontal bars that get longer each time. In each bar, everything from the previous request is shaded as read from cache, and only a short piece at the end is new and written to cache.</desc>
		<g font-size="12">
			{
				bars.map((b, i) => (
					<>
						<text x="20" y={b.y + 15} class="svg-fg">request {i + 1}</text>
						{i === 0 ? (
							<rect x="120" y={b.y} width={b.cached + b.fresh} height="22" fill="var(--s2)" />
						) : (
							<>
								<rect x="120" y={b.y} width={b.cached} height="22" fill="var(--s1)" />
								<rect x={122 + b.cached} y={b.y} width={b.fresh} height="22" fill="var(--s2)" />
							</>
						)}
					</>
				))
			}
			<rect x="120" y="200" width="12" height="12" fill="var(--s1)"></rect><text x="138" y="210" class="svg-muted">re-sent, read from cache (cheap)</text>
			<rect x="360" y="200" width="12" height="12" fill="var(--s2)"></rect><text x="378" y="210" class="svg-muted">new this request, written to cache</text>
		</g>
	</svg>
	<figcaption>Each request carries the previous one plus a bit more. The total area grows with the square of the number of requests.</figcaption>
</figure>
