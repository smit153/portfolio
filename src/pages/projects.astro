---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import AsciiField from '../components/AsciiField.astro';
import Band from '../components/Band.astro';
import PageTitle from '../components/PageTitle.astro';
import ProjectTree from '../components/ProjectTree.astro';
import { getProjects } from '../lib/projects';
import { breadcrumbs, titled } from '../lib/seo';

const projects = await getProjects();
---

<Layout
	title={titled('Projects')}
	description="Things Smit Sojitra has built: BeyondDiff, ModelMux, Oshi, Doodlesy and more, each with a case study on how it works and why."
	jsonLd={breadcrumbs([{ name: 'Projects', path: '/projects/' }])}
>
	<div class="min-h-screen overflow-x-clip bg-ink">
		<!-- a full-height column, so the strip below sits at the bottom of the window when there is little content -->
		<main class="relative mx-auto flex min-h-screen w-full max-w-[768px] flex-col border-x-2 border-line">
			<Header />
			<Band />
			<PageTitle>Projects</PageTitle>
			<p class="relative px-5 pb-5 pt-4 text-body tracking-[-0.04em] text-muted">
				Things I've built, from AI developer tools to browser games. Each has a case study: why I built it, how it works, the tradeoffs and what was hard.
				<span aria-hidden="true" class="absolute inset-x-[-50vw] bottom-0 h-[2px] bg-line"></span>
			</p>
			<ProjectTree projects={projects} />
			<AsciiField class="mt-auto" />
		</main>
		<Footer />
	</div>
</Layout>
