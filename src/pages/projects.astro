---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import AsciiField from '../components/AsciiField.astro';
import Band from '../components/Band.astro';
import PageTitle from '../components/PageTitle.astro';
import ProjectTree from '../components/ProjectTree.astro';
import { projects } from '../data/projects';
---

<Layout title="Projects · Smit Sojitra">
	<div class="min-h-screen overflow-x-clip bg-ink">
		<!-- a full-height column, so the strip below sits at the bottom of the window when there is little content -->
		<main class="relative mx-auto flex min-h-screen w-full max-w-[768px] flex-col border-x-2 border-line">
			<Header />
			<Band />
			<PageTitle>Projects</PageTitle>
			<ProjectTree projects={projects} />
			<AsciiField class="mt-auto" />
		</main>
	</div>
</Layout>
