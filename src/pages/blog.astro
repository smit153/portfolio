---
// All posts: the home card (image, title, summary, arrow) as a full-width row with a meta block. Rows alternate
// which wall the square image sits on, and a band sits between them.
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import arrowUp from '../assets/icons/arrow-up.svg';
import AsciiField from '../components/AsciiField.astro';
import Band from '../components/Band.astro';
import PageTitle from '../components/PageTitle.astro';
import PostMeta from '../components/blog/PostMeta.astro';
import { getPosts } from '../lib/posts';

const posts = await getPosts();
---

<Layout title="Writing · Smit Sojitra" description="Notes by Smit Sojitra on AI, databases and building software, with interactive demos.">
	<div class="min-h-screen overflow-x-clip bg-ink">
		<!-- a full-height column, so the strip below sits at the bottom of the window when there is little content -->
		<main class="relative mx-auto flex min-h-screen w-full max-w-[768px] flex-col border-x-2 border-line">
			<Header />
			<Band />
			<PageTitle>Writing</PageTitle>
			<ol>
				{
					posts.map((post, i) => (
						<li>
							{i > 0 && <Band />}
							<a href={post.href} class:list={['post group', i % 2 && 'flip']}>
								<div class="img">
									<Image src={post.data.cover} alt="" width={440} height={440} format="webp" class="size-full object-cover [image-rendering:pixelated]" />
								</div>
								<div class="txt">
									<span class="absolute right-3.5 top-3.5 flex size-8 items-center justify-center border-2 border-line bg-ink transition-colors group-hover:border-tick">
										<img src={arrowUp.src} alt="" width="13" height="14" class="rotate-[38deg]" />
									</span>
									<h2 class="mb-1.5 mr-10 text-heading tracking-[-0.01em] text-white decoration-tick underline-offset-4 group-hover:underline">
										{post.data.title}
									</h2>
									<p class="text-body tracking-[-0.04em] text-muted">{post.data.description}</p>
									<span class="mt-auto pt-4 text-small text-white">
										<span class="border-b border-tick">read the note</span>
										<img src={arrowUp.src} alt="" width="13" height="14" class="ml-1.5 inline rotate-90 transition-transform group-hover:translate-x-0.5" />
									</span>
								</div>
								<PostMeta post={post} number={posts.length - i} total={posts.length} class="meta-col" />
							</a>
						</li>
					))
				}
			</ol>
			<AsciiField class="mt-auto" />
		</main>
		<Footer />
	</div>
</Layout>

<style>
	.post {
		display: grid;
		grid-template-columns: 220px 1fr 250px;
	}
	.post.flip {
		grid-template-columns: 250px 1fr 220px;
	}
	.img {
		overflow: hidden;
		border-right: 2px solid var(--color-line);
	}
	.img :global(img) {
		aspect-ratio: 1;
		transition: transform 0.3s ease;
	}
	.post:hover .img :global(img) {
		transform: scale(1.04);
	}
	.txt {
		position: relative;
		display: flex;
		flex-direction: column;
		padding: 18px 20px;
	}
	/* the meta block's column (its own styles are in PostMeta) */
	.post :global(.meta-col) {
		border-left: 2px solid var(--color-line);
	}
	/* flipped rows: meta on the left, image on the right */
	.flip :global(.meta-col) {
		order: 1;
		border-left: 0;
		border-right: 2px solid var(--color-line);
	}
	.flip .txt {
		order: 2;
	}
	.flip .img {
		order: 3;
		border-right: 0;
		border-left: 2px solid var(--color-line);
	}
	/* narrow screens: image and text side by side, the meta block underneath */
	@media (max-width: 700px) {
		.post,
		.post.flip {
			grid-template-columns: 120px 1fr;
		}
		.flip .img {
			order: 0;
			border-left: 0;
			border-right: 2px solid var(--color-line);
		}
		.flip .txt {
			order: 0;
		}
		.post :global(.meta-col),
		.flip :global(.meta-col) {
			order: 3;
			grid-column: span 2;
			border: 0;
			border-top: 2px solid var(--color-line);
		}
	}
</style>
