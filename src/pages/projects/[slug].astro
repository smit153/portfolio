---
// One project's case study: a top row (back, copy link, next), the title with its summary and stack, the cover
// (or the project's pixel icon, large) beside its meta, the numbered sections, previous/next cards and the
// floating section pill.
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import arrowUp from '../../assets/icons/arrow-up.svg';
import link from '../../assets/icons/link.svg';
import AsciiField from '../../components/AsciiField.astro';
import Band from '../../components/Band.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import Pill from '../../components/Pill.astro';
import PixelIcon from '../../components/PixelIcon.astro';
import SectionPill from '../../components/blog/SectionPill.astro';
import Diagrams from '../../components/project/Diagrams.astro';
import ProjectMeta from '../../components/project/ProjectMeta.astro';
import { getProjects } from '../../lib/projects';
import '../../styles/prose.css';
import '../../styles/project.css';

export async function getStaticPaths() {
	const projects = await getProjects();
	return projects.map((project, i) => ({
		params: { slug: project.id },
		props: { project, previous: projects[i - 1], next: projects[i + 1] },
	}));
}

const { project, previous, next } = Astro.props;
const p = project.data;
const { Content, headings } = await render(project);
const sections = headings.filter((h) => h.depth === 2);
---

<Layout title={`${p.title} · Smit Sojitra`}>
	<div class="min-h-screen overflow-x-clip bg-ink">
		<main class="relative mx-auto flex min-h-screen w-full max-w-[768px] flex-col border-x-2 border-line">
			<Header />
			<Band />

			<!-- back, copy link, next -->
			<div class="relative flex h-12 items-center justify-between gap-4 px-5">
				<a href="/projects" class="group flex items-center gap-2 text-small text-muted transition-colors hover:text-white">
					<img src={arrowUp.src} alt="" width="13" height="14" class="-rotate-90 opacity-70 transition-[opacity,translate] group-hover:-translate-x-0.5 group-hover:opacity-100" />
					projects
				</a>
				<div class="flex items-center gap-2">
					<button type="button" data-copy-link class="flex h-8 items-center gap-2 border border-line px-3 text-small text-muted transition-colors hover:border-tick hover:text-white">
						<img src={link.src} alt="" width="14" height="14" class="size-3.5 opacity-80" />
						<span data-copy-label>copy link</span>
					</button>
					{
						next ? (
							<a href={next.href} aria-label={`Next project: ${next.data.title}`} title={next.data.title} class="flex size-8 items-center justify-center border border-line transition-colors hover:border-tick">
								<img src={arrowUp.src} alt="" width="13" height="14" class="rotate-90" />
							</a>
						) : (
							<span aria-hidden="true" class="flex size-8 items-center justify-center border border-line opacity-30">
								<img src={arrowUp.src} alt="" width="13" height="14" class="rotate-90" />
							</span>
						)
					}
				</div>
				<span aria-hidden="true" class="absolute inset-x-[-50vw] bottom-0 h-[2px] bg-line"></span>
			</div>

			<!-- title block -->
			<header class="px-5 pb-6 pt-8">
				<div class="flex items-center gap-3">
					<PixelIcon name={p.icon} class="shrink-0 text-white" />
					<h1 class="text-[28px] leading-9 tracking-[-0.03em] text-white">{p.title}</h1>
				</div>
				<p class="mt-3 text-[16px] leading-7 tracking-[-0.02em] text-muted">{p.summary}</p>
				<ul class="mt-5 flex flex-wrap gap-[3px]" aria-label="Stack">
					{
						p.stack.map((s) => (
							<li>
								<Pill>{s}</Pill>
							</li>
						))
					}
				</ul>
			</header>
			<div class="relative grid border-t-2 border-line sm:grid-cols-[1fr_280px]">
				<span aria-hidden="true" class="absolute inset-x-[-50vw] top-[-2px] h-[2px] bg-line"></span>
				{
					p.cover ? (
						<Image
							src={p.cover}
							alt={p.coverAlt ?? ''}
							width={1280}
							height={720}
							format="webp"
							loading="eager"
							fetchpriority="high"
							class="aspect-video w-full object-cover [image-rendering:pixelated] sm:border-r-2 sm:border-line"
						/>
					) : (
						<div class="bg-hatch flex aspect-video w-full items-center justify-center sm:border-r-2 sm:border-line">
							<span class="bg-ink p-5">
								<PixelIcon name={p.icon} scale={8} class="text-white" />
							</span>
						</div>
					)
				}
				<ProjectMeta project={project} class="border-t-2 border-line sm:border-t-0" />
			</div>

			<!-- the case study -->
			<article class="prose case relative border-t-2 border-line px-5 pb-16 pt-8">
				<span aria-hidden="true" class="absolute inset-x-[-50vw] top-[-2px] h-[2px] bg-line"></span>
				<Content />
			</article>

			<!-- previous / next -->
			<nav aria-label="More projects" class="relative grid border-t-2 border-line sm:grid-cols-2">
				<span aria-hidden="true" class="absolute inset-x-[-50vw] top-[-2px] h-[2px] bg-line"></span>
				{
					[
						{ project: previous, label: 'previous' },
						{ project: next, label: 'next' },
					].map(({ project: other, label }, i) =>
						other ? (
							<a href={other.href} class:list={['group flex flex-col gap-1 px-5 py-5 transition-colors hover:bg-[#0e0e10]', i === 1 && 'sm:items-end sm:border-l-2 sm:border-line sm:text-right']}>
								<span class="text-small text-tick">{label === 'previous' ? '← previous' : 'next →'}</span>
								<span class="text-heading tracking-[-0.01em] text-white decoration-tick underline-offset-4 group-hover:underline">{other.data.title}</span>
								<span class="text-small text-muted">{other.data.tagline}</span>
							</a>
						) : (
							<a href="/projects" class:list={['group flex flex-col gap-1 px-5 py-5 transition-colors hover:bg-[#0e0e10]', i === 1 && 'sm:items-end sm:border-l-2 sm:border-line sm:text-right']}>
								<span class="text-small text-tick">{label === 'previous' ? '← back to' : 'back to →'}</span>
								<span class="text-heading tracking-[-0.01em] text-white decoration-tick underline-offset-4 group-hover:underline">all projects</span>
							</a>
						),
					)
				}
			</nav>

			<AsciiField class="mt-auto" />
		</main>
		<Footer />
	</div>
	<SectionPill sections={sections} />
	<Diagrams />
</Layout>

<script>
	// copy the page's address, and say so for a moment
	const button = document.querySelector<HTMLButtonElement>('[data-copy-link]');
	const label = document.querySelector('[data-copy-label]');
	button?.addEventListener('click', async () => {
		try {
			await navigator.clipboard.writeText(location.href.split('#')[0]);
			if (label) label.textContent = 'copied';
		} catch {
			if (label) label.textContent = 'press ctrl+c';
		}
		setTimeout(() => label && (label.textContent = 'copy link'), 1600);
	});
</script>
