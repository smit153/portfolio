---
import { getImage } from 'astro:assets';
import avatar from '../assets/images/avatar-glasses.png';
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import About from '../components/About.astro';
import Band from '../components/Band.astro';
import AsciiField from '../components/AsciiField.astro';
import Contact from '../components/Contact.astro';
import DeskCat from '../components/DeskCat.astro';
import Experience from '../components/Experience.astro';
import GithubGraph from '../components/GithubGraph.astro';
import InfoGrid from '../components/InfoGrid.astro';
import ProfileLinks from '../components/ProfileLinks.astro';
import ProfileRow from '../components/ProfileRow.astro';
import Projects from '../components/Projects.astro';
import RiveHero from '../components/RiveHero.astro';
import MarginNote from '../components/MarginNote.astro';
import SectionTitle from '../components/SectionTitle.astro';
import Separator from '../components/Separator.astro';
import Stack from '../components/Stack.astro';
import Writing from '../components/Writing.astro';
import { abs, person, website } from '../lib/seo';

// the portrait search engines can show next to my name
const photo = await getImage({ src: avatar, width: 400, height: 400, format: 'png' });
---

<Layout
	title="Smit Sojitra – Software Developer & AI Engineer in Bangalore"
	description="Smit Sojitra, software developer and AI engineer in Bangalore: full-stack apps, AI agents, LLM workflows and DevOps. Projects, writing and a desk cat."
	jsonLd={[person(abs(photo.src)), website]}
>
	<div class="min-h-screen overflow-x-clip bg-ink">
		<!-- the page column: its side borders are the full-height column guides -->
		<main class="relative mx-auto min-h-screen w-full max-w-[768px] border-x-2 border-line">
			<Header />
			<RiveHero />
			<ProfileRow />
			<Separator />
			<InfoGrid />
			<!-- phones: the résumé and socials come after the contact details (tablet up, they're in the profile row) -->
			<ProfileLinks layout="row" class="sm:hidden" />
			<Band />
			
			<About />
			<Separator />
			<section aria-labelledby="github-title" class="relative">
				<SectionTitle id="github-title">GitHub Activity</SectionTitle>
				<MarginNote side="left" top="72px">
					Every square is<br />a day of building.
				</MarginNote>
				<GithubGraph />
			</section>
			<Band />


			<Experience />
			<Band />
			<Projects />
			<Band />
			<Stack />
			<Band />
			<Writing />
			<Band />
			<Contact />
			<AsciiField petHome />
		</main>
		<Footer />
	</div>
	<DeskCat />
</Layout>
