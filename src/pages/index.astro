---
import Layout from '../layouts/Layout.astro';
import dino from '../assets/icons/dino.svg';
import About from '../components/About.astro';
import Band from '../components/Band.astro';
import Blogs from '../components/Blogs.astro';
import AsciiField from '../components/AsciiField.astro';
import Contact from '../components/Contact.astro';
import DeskCat from '../components/DeskCat.astro';
import Experience from '../components/Experience.astro';
import GithubGraph from '../components/GithubGraph.astro';
import InfoGrid from '../components/InfoGrid.astro';
import ProfileRow from '../components/ProfileRow.astro';
import Projects from '../components/Projects.astro';
import RiveHero from '../components/RiveHero.astro';
import Separator from '../components/Separator.astro';
import Stacks from '../components/Stacks.astro';
---

<Layout title="Smit Sojitra">
	<div class="min-h-screen overflow-x-clip bg-ink">
		<!-- the page column: its side borders are the full-height column guides -->
		<main class="relative mx-auto min-h-screen w-full max-w-[768px] border-x-2 border-line">
			<Band />
			<RiveHero />
			<ProfileRow />
			<Separator />
			<InfoGrid />
			<!-- <AsciiField  /> -->
			<Band />
			
			<About />
			<Separator />
			<GithubGraph />
			<Band />


			<Experience />
			<Band />
			<Projects />
			<Band />
			<Stacks />
			<Band />
			<Blogs />
			<Band>
				<img src={dino.src} alt="" width="18" height="18" class="absolute right-4 top-1/2 -translate-y-1/2" />
			</Band>
			<Contact />
			<AsciiField petHome />
		</main>
	</div>
	<DeskCat />
</Layout>
