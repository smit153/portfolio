---
// Any address with no page: says so, points home, and stays out of search results.
// The 404 draws itself in one thin line, then fills in; the copy follows once it's done.
import Layout from '../layouts/Layout.astro';
import AsciiField from '../components/AsciiField.astro';
import Band from '../components/Band.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { titled } from '../lib/seo';
---

<Layout title={titled('Page not found')} description="There's no page at this address on smiit.in." noindex>
	<div class="min-h-screen overflow-x-clip bg-ink">
		<main class="relative mx-auto flex min-h-screen w-full max-w-[768px] flex-col border-x-2 border-line">
			<Header />
			<Band />
			<div class="flex flex-1 flex-col items-center justify-center gap-5 px-5 py-16 text-center">
				<h1 class="w-full max-w-[520px]">
					<span class="sr-only">Page not found (404)</span>
					<svg viewBox="0 0 520 170" aria-hidden="true" class="drawn block h-auto w-full overflow-visible">
						<text x="260" y="150" text-anchor="middle">404</text>
					</svg>
				</h1>
				<p class="after text-body tracking-[-0.04em] text-muted">This page doesn't exist. It may have moved, or the link has a typo.</p>
				<p class="after flex flex-wrap justify-center gap-x-5 gap-y-2 text-body tracking-[-0.04em]">
					<a href="/" class="text-white underline decoration-tick underline-offset-4 hover:decoration-white">Go home</a>
					<a href="/writing/" class="text-white underline decoration-tick underline-offset-4 hover:decoration-white">Writing</a>
					<a href="/projects/" class="text-white underline decoration-tick underline-offset-4 hover:decoration-white">Projects</a>
				</p>
			</div>
			<AsciiField />
		</main>
		<Footer />
	</div>
</Layout>

<style>
	.drawn text {
		font-family: var(--font-sohne-mono);
		font-size: 180px;
		font-weight: 500;
		letter-spacing: -14px;
		fill: transparent;
		stroke: #fff;
		stroke-width: 1.5;
		/* longer than any glyph's outline, so each one draws from nothing */
		stroke-dasharray: 900;
		stroke-dashoffset: 900;
		animation:
			draw 2.2s ease-in-out forwards,
			fill 0.8s 2s ease forwards;
	}
	@keyframes draw {
		to {
			stroke-dashoffset: 0;
		}
	}
	@keyframes fill {
		to {
			fill: #fff;
			stroke-width: 0;
		}
	}
	/* the copy and links rise in as the number fills */
	.after {
		opacity: 0;
		transform: translateY(6px);
		animation: rise 0.5s 2.6s ease forwards;
	}
	.after + .after {
		animation-delay: 2.72s;
	}
	@keyframes rise {
		to {
			opacity: 1;
			transform: none;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.drawn text,
		.after {
			animation: none;
			opacity: 1;
			transform: none;
			fill: #fff;
			stroke-width: 0;
		}
	}
</style>
