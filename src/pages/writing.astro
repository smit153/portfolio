---
// All posts: the home card (image, title, summary, arrow) as a full-width row with a meta block. The title runs across
// the top beside the image, with the summary and the meta block under it. Rows alternate which wall the square image
// sits on, and a band sits between them. On phones the image becomes a banner on top.
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import arrowUp from '../assets/icons/arrow-up.svg';
import AsciiField from '../components/AsciiField.astro';
import Band from '../components/Band.astro';
import PageTitle from '../components/PageTitle.astro';
import PostMeta from '../components/blog/PostMeta.astro';
import { getPosts } from '../lib/posts';

const posts = await getPosts();
---

<Layout title="Writing · Smit Sojitra" description="Writing by Smit Sojitra on AI, databases and building software, with interactive demos.">
	<div class="min-h-screen overflow-x-clip bg-ink">
		<!-- a full-height column, so the strip below sits at the bottom of the window when there is little content -->
		<main class="relative mx-auto flex min-h-screen w-full max-w-[768px] flex-col border-x-2 border-line">
			<Header />
			<Band />
			<PageTitle>Writing</PageTitle>
			<ol>
				{
					posts.map((post, i) => (
						<li>
							{i > 0 && <Band />}
							<a href={post.href} class:list={['post group', i % 2 && 'flip']}>
								<div class="img">
									{/* the square cover beside the text; on phones the image is a 16:9 banner, so it takes the wide one */}
									<picture class="block size-full">
										<source media="(max-width: 700px)" srcset={post.data.cover.src} />
										<img src={(post.data.coverSquare ?? post.data.cover).src} alt="" width={(post.data.coverSquare ?? post.data.cover).width} height={(post.data.coverSquare ?? post.data.cover).height} loading={i ? 'lazy' : 'eager'} decoding="async" class="size-full object-cover" />
									</picture>
								</div>
								<div class="ttl">
									<span class="absolute -right-[2px] -top-[2px] flex size-8 items-center justify-center border-2 border-line bg-ink transition-colors group-hover:border-tick">
										<img src={arrowUp.src} alt="" width="13" height="14" class="rotate-[38deg]" />
									</span>
									<h2 class="mr-10 text-heading tracking-[-0.01em] text-white decoration-tick underline-offset-4 group-hover:underline">
										{post.data.title}
									</h2>
								</div>
								<div class="txt">
									<p class="line-clamp-5 text-body tracking-[-0.04em] text-muted">{post.data.description}</p>
									<span class="mt-auto pt-4 text-small text-white">
										<span class="border-b border-tick">read the note</span>
										<img src={arrowUp.src} alt="" width="13" height="14" class="ml-1.5 inline rotate-90 transition-transform group-hover:translate-x-0.5" />
									</span>
								</div>
								<PostMeta post={post} number={posts.length - i} total={posts.length} class="meta-col" />
							</a>
						</li>
					))
				}
			</ol>
			<AsciiField class="mt-auto" />
		</main>
		<Footer />
	</div>
</Layout>

<style>
	/* image | title over (summary, meta); flipped rows mirror it */
	.post {
		display: grid;
		grid-template-columns: 32% 1fr 264px;
		grid-template-rows: auto 1fr;
		grid-template-areas:
			'img ttl ttl'
			'img txt meta';
	}
	.post.flip {
		grid-template-columns: 264px 1fr 32%;
		grid-template-areas:
			'ttl ttl img'
			'meta txt img';
	}
	.img {
		grid-area: img;
		overflow: hidden;
		border-right: 2px solid var(--color-line);
	}
	/* the image fills its cell, whatever height the title, summary and meta give the row */
	.img :global(img) {
		transition: transform 0.3s ease;
	}
	.post:hover .img :global(img) {
		transform: scale(1.04);
	}
	.ttl {
		grid-area: ttl;
		position: relative;
		padding: 18px 20px 14px;
		border-bottom: 2px solid var(--color-line);
	}
	.txt {
		grid-area: txt;
		display: flex;
		flex-direction: column;
		padding: 14px 20px 18px;
	}
	/* the meta block's column (its own styles are in PostMeta); its cells share the title's 20px inset */
	.post :global(.meta-col) {
		grid-area: meta;
		border-left: 2px solid var(--color-line);
	}
	.post :global(.meta-col > div) {
		padding-inline: 20px;
	}
	.flip .img {
		border-right: 0;
		border-left: 2px solid var(--color-line);
	}
	.flip :global(.meta-col) {
		border-left: 0;
		border-right: 2px solid var(--color-line);
	}
	/* narrow screens: one column, the image a 16:9 banner on top, then the title, the text and the meta block */
	@media (max-width: 700px) {
		.post,
		.post.flip {
			grid-template-columns: 1fr;
			grid-template-rows: none;
			grid-template-areas: 'img' 'ttl' 'txt' 'meta';
		}
		.img,
		.flip .img {
			border: 0;
			border-bottom: 2px solid var(--color-line);
		}
		.img :global(img) {
			aspect-ratio: 16 / 9;
		}
		.ttl {
			padding-bottom: 6px;
			border-bottom: 0;
		}
		.txt {
			padding-top: 0;
		}
		.post :global(.meta-col),
		.flip :global(.meta-col) {
			border: 0;
			border-top: 2px solid var(--color-line);
		}
	}
</style>
