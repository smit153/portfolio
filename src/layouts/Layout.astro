---
import { Font, fontData } from 'astro:assets';
import '../styles/global.css';

interface Props {
	title: string;
	/** for search results and link previews; posts and projects pass their own */
	description?: string;
	/** 'article' for posts and project pages */
	type?: 'website' | 'article';
}

const {
	title,
	description = 'Smit Sojitra, software developer and AI engineer: full-stack, AI agents, cloud & DevOps. Projects, notes and a desk cat.',
	type = 'website',
} = Astro.props;
// Caveat is only on screen at first on wide screens (the hero's side notes), so phones don't fetch it up front
const caveatUrl = fontData['--font-caveat']?.[0]?.src[0]?.url;
// absolute addresses, as link previews need them
const url = new URL(Astro.url.pathname, Astro.site);
const image = new URL('/og.png', Astro.site);
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<!-- the pixel initials (scripts/build-favicon.mjs) -->
		<link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="theme-color" content="#09090b" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={url} />
		<!-- link previews (Open Graph, X): the spec-sheet card in public/og.png -->
		<meta property="og:type" content={type} />
		<meta property="og:site_name" content="smiit.in" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={url} />
		<meta property="og:image" content={image} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Smit Sojitra, Software Developer and AI Engineer, smiit.in" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:site" content="@smit_sojitra153" />
		<meta name="twitter:creator" content="@smit_sojitra153" />
		<!-- must run before @rive-app/canvas loads: remember every AudioContext so a key press can resume them -->
		<script is:inline>
			window.__audioContexts = [];
			for (const name of ['AudioContext', 'webkitAudioContext']) {
				const Base = window[name];
				if (typeof Base === 'function')
					window[name] = class extends Base {
						constructor(...a) {
							super(...a);
							window.__audioContexts.push(this);
						}
					};
			}
		</script>
		<!-- preload only what's on screen first: Söhne Mono Buch (400) + Kräftig (500), Grape Nuts for section titles, Caveat for the notes (xl only) -->
		<Font
			cssVariable="--font-sohne-mono"
			preload={[
				{ weight: 400, style: 'normal' },
				{ weight: 500, style: 'normal' },
			]}
		/>
		<Font cssVariable="--font-grape-nuts" preload={[{ weight: 400, style: 'normal' }]} />
		<Font cssVariable="--font-caveat" />
		{caveatUrl && <link rel="preload" href={caveatUrl} as="font" type="font/woff2" crossorigin media="(min-width: 1280px)" />}
	</head>
	<body class="font-sohne">
		<slot />
	</body>
</html>
